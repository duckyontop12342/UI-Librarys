-- fonts (fallback to Gotham if custom fail)
local FontMain  = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium)
local FontTitle = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)

pcall(function()
	local function ensure(name, url, weight)
		if isfile(name) then return end
		writefile(name, game:HttpGet(url))
		local j = HttpService:JSONEncode({
			faces = {{ assetId = "rbxasset://" .. name, name = name, style = "Regular", weight = weight or 400 }},
			name = name
		})
		writefile("Evenesce/Assets/" .. name:gsub("%.ttf$", ".font"), j)
	end
	ensure("Figtree-Semibold", "https://github.com/sametexe001/luas/raw/refs/heads/main/fonts/Figtree-SemiBold.ttf", 400)
	ensure("ActayWide-Bold",   "https://github.com/Da7mu/font/raw/refs/heads/main/ActayWide-Bold.ttf", 700)
	FontMain  = Font.new("rbxasset://Evenesce/Assets/figtree-Semibold.font")
