					local fill = Instance.new("Frame")
					fill.BackgroundColor3 = Color3.new(1,1,1)
					fill.BorderSizePixel = 0
					fill.Size = UDim2.new((def - min) / math.max(max - min, 1e-4), 0, 1, 0)
					fill.ZIndex = 11
					fill.Parent = track
					Corner(fill, 1, 0)

					local g = Instance.new("UIGradient")
					g.Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, T.Accent),
						ColorSequenceKeypoint.new(1, T.AccentDark)
					})
					g.Parent = fill

					local dragging = false
					local function update(x)
						local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
						local v = math.floor((min + (max - min) * rel) / float + 0.5) * float
						v = math.clamp(v, min, max)
						fill.Size = UDim2.new((v - min) / math.max(max - min, 1e-4), 0, 1, 0)
						valL.Text = tostring(v) .. suffix
						if flag then Library.Flags[flag] = v end
						if cb then task.spawn(cb, v) end
					end
					C(track.InputBegan, function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(i.Position.X) end
					end)
					C(UserInputService.InputChanged, function(i)
						if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then update(i.Position.X) end
					end)
					C(UserInputService.InputEnded, function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
					end)
					if flag then Library.Flags[flag] = def end
					return { Set = function(_, v) update(track.AbsolutePosition.X + ((v-min)/(max-min))*track.AbsoluteSize.X) end }
				end

