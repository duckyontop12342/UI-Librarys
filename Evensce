					box.Parent = row
					Corner(box, 0, 4)

					local check = Instance.new("ImageLabel")
					check.BackgroundTransparency = 1
					check.Image = "rbxassetid://10709790644"
					check.ImageColor3 = Library.Theme.Check
					check.ImageTransparency = state and 0 or 1
					check.Position = UDim2.fromOffset(2, 2)
					check.Size = UDim2.fromOffset(14, 14)
					check.ZIndex = 20
					check.Parent = box

					local nameL = Instance.new("TextLabel")
					nameL.BackgroundTransparency = 1
					nameL.FontFace = FontMain
					nameL.Text = o.Name or "Toggle"
					nameL.TextColor3 = state and Library.Theme.Text or Library.Theme.DimText
					nameL.TextSize = 13
					nameL.TextXAlignment = Enum.TextXAlignment.Left
					nameL.Position = UDim2.fromOffset(26, 0)
					nameL.Size = UDim2.new(1, -80, 1, 0)
					nameL.ZIndex = 19
					nameL.Parent = row

					local hit = Instance.new("TextButton")
					hit.BackgroundTransparency = 1
					hit.Text = ""
					hit.Size = UDim2.fromScale(1, 1)
					hit.ZIndex = 21
					hit.Parent = row

					local function set(v)
						state = v
						Tween(box, { BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Element }, 0.18)
						Tween(check, { ImageTransparency = state and 0 or 1 }, 0.18)
						Tween(nameL, { TextColor3 = state and Library.Theme.Text or Library.Theme.DimText }, 0.18)
						if flag then Library.Flags[flag] = state end
						if cb then task.spawn(cb, state) end
					end
					Connect(hit.MouseButton1Click, function() set(not state) end)
					if flag then Library.Flags[flag] = state end

					local ToggleObj = { Set = set, State = function() return state end }

					function ToggleObj:Keybind(kOpts)
						kOpts = kOpts or {}
						local kFlag = kOpts.Flag or (flag .. "_Key")
						local mode = kOpts.Mode or "Toggle"
						local key = kOpts.Default or Enum.KeyCode.Unknown
						Library.Flags[kFlag] = key

						local kLbl = Instance.new("TextLabel")
