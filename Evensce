	d.Parent = n

	local close = Instance.new("ImageButton")
	close.BackgroundTransparency = 1
	close.Image = "rbxassetid://10747384394"
	close.ImageColor3 = self.Theme.DimText
	close.Position = UDim2.new(1, -26, 0, 12)
	close.Size = UDim2.fromOffset(14, 14)
	close.ZIndex = 102
	close.Parent = n

	local barBg = Instance.new("Frame")
	barBg.BackgroundColor3 = self.Theme.Element
	barBg.BorderSizePixel = 0
	barBg.Position = UDim2.new(0, 14, 1, -10)
	barBg.Size = UDim2.new(1, -28, 0, 4)
	barBg.ZIndex = 101
	barBg.Parent = n
	Corner(barBg, 1, 0)

	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = self.Theme.Accent
	bar.BorderSizePixel = 0
	bar.Size = UDim2.new(1, 0, 1, 0)
	bar.ZIndex = 102
	bar.Parent = barBg
	Corner(bar, 1, 0)

	Tween(n, { Position = UDim2.new(1, -15, 0, 15) }, 0.4, Enum.EasingStyle.Exponential)

	local closed = false
	local function kill()
		if closed then return end
		closed = true
		Tween(n, { Position = UDim2.new(1, 20, 0, 15), BackgroundTransparency = 1 }, 0.25)
		task.delay(0.3, function() n:Destroy() end)
	end
	Connect(close.MouseButton1Click, kill)
	Tween(bar, { Size = UDim2.new(0, 0, 1, 0) }, dur, Enum.EasingStyle.Linear)
	task.delay(dur, kill)
	table.insert(self.Notifs, n)
	return n
end

