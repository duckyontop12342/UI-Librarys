					nameL.Parent = row

					local valL = Instance.new("TextLabel")
					valL.BackgroundTransparency = 1
					valL.FontFace = FontMain
					valL.Text = tostring(def) .. suffix
					valL.TextColor3 = Library.Theme.Text
					valL.TextSize = 13
					valL.TextXAlignment = Enum.TextXAlignment.Right
					valL.Position = UDim2.new(1, -50, 0, 2)
					valL.Size = UDim2.fromOffset(50, 16)
					valL.ZIndex = 19
					valL.Parent = row

					local track = Instance.new("Frame")
					track.BackgroundColor3 = Library.Theme.Element
					track.BorderSizePixel = 0
					track.Position = UDim2.fromOffset(0, 24)
					track.Size = UDim2.new(1, 0, 0, 6)
					track.ZIndex = 19
					track.Parent = row
					Corner(track, 1, 0)

					local fill = Instance.new("Frame")
					fill.BackgroundColor3 = Library.Theme.Accent
					fill.BorderSizePixel = 0
					fill.Size = UDim2.new((def - min) / math.max(max - min, 1e-4), 0, 1, 0)
					fill.ZIndex = 20
					fill.Parent = track
					Corner(fill, 1, 0)

					local dragging = false
					local function update(x)
						local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
						local v = math.floor((min + (max - min) * rel) / float + 0.5) * float
						v = math.clamp(v, min, max)
						fill.Size = UDim2.new((v - min) / math.max(max - min, 1e-4), 0, 1, 0)
						valL.Text = tostring(v) .. suffix
						if flag then Library.Flags[flag] = v end
						if cb then task.spawn(cb, v) end
					end
					Connect(track.InputBegan, function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(i.Position.X) end
					end)
					Connect(UserInputService.InputChanged, function(i)
						if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then update(i.Position.X) end
					end)
					Connect(UserInputService.InputEnded, function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
					end)
					if flag then Library.Flags[flag] = def end
					return { Set = function(_, v) update(track.AbsolutePosition.X + ((v - min) / (max - min)) * track.AbsoluteSize.X) end }
				end

