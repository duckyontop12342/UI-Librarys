local function C(sig, fn)
	local c = sig:Connect(fn)
	table.insert(Library.Connections, c)
	return c
end

local function Corner(p, s, o)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(s or 0, o or 6)
	c.Parent = p
	return c
end

local function Tween(obj, props, dur, style)
	local t = TweenService:Create(obj, TweenInfo.new(dur or 0.25, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function Ripple(frame)
	frame.ClipsDescendants = true
	local m = UserInputService:GetMouseLocation()
	local abs, size = frame.AbsolutePosition, frame.AbsoluteSize
	local rx = math.clamp((m.X - abs.X) / math.max(size.X, 1), 0, 1)
	local ry = math.clamp((m.Y - guiInset.Y - abs.Y) / math.max(size.Y, 1), 0, 1)
	local r = Instance.new("Frame")
	r.AnchorPoint = Vector2.new(0.5, 0.5)
	r.BackgroundColor3 = T.Ripple
	r.BackgroundTransparency = 0.5
	r.Position = UDim2.fromScale(rx, ry)
	r.Size = UDim2.fromOffset(0, 0)
	r.ZIndex = frame.ZIndex + 3
	r.BorderSizePixel = 0
	r.Parent = frame
	Corner(r, 1, 0)
	local max = math.max(size.X, size.Y) * 1.35
	Tween(r, { BackgroundTransparency = 1, Size = UDim2.fromOffset(max, max) }, 0.45, Enum.EasingStyle.Quad)
	task.delay(0.5, function() r:Destroy() end)
end

