				check.Image = "rbxassetid://10709790644"
				check.ImageColor3 = Evenesce.Theme.CheckColor
				check.ImageTransparency = def and 0 or 1
				check.Position = UDim2.fromOffset(2, def and 2 or 10)
				check.Size = UDim2.fromOffset(14, 14)
				check.ZIndex = 8
				check.Parent = box

				local lbl = Instance.new("TextLabel")
				lbl.BackgroundTransparency = 1
				lbl.FontFace = FontMain
				lbl.Text = tOpts.Name or "Toggle"
				lbl.TextColor3 = def and Evenesce.Theme.Text or Evenesce.Theme.DimText
				lbl.TextSize = 14
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.Position = UDim2.fromOffset(41, 0)
				lbl.Size = UDim2.new(1, -50, 1, 0)
				lbl.ZIndex = 7
				lbl.Parent = row.Instance

				local state = def
				local hit = Instance.new("TextButton")
				hit.BackgroundTransparency = 1
				hit.Text = ""
				hit.Size = UDim2.fromScale(1, 1)
				hit.ZIndex = 9
				hit.Parent = row.Instance

				Connect(hit.MouseButton1Down, function()
					state = not state
					Tween(box, { BackgroundColor3 = state and Evenesce.Theme.Accent or Evenesce.Theme.Element }, 0.22)
					Tween(check, { ImageTransparency = state and 0 or 1, Position = UDim2.fromOffset(2, state and 2 or 10) }, 0.22)
					Tween(lbl, { TextColor3 = state and Evenesce.Theme.Text or Evenesce.Theme.DimText }, 0.22)
					if flag then Evenesce.Flags[flag] = state end
					if cb then task.spawn(cb, state) end
				end)

				if flag then Evenesce.Flags[flag] = state end
				return { Set = function(_, v)
					state = v
					box.BackgroundColor3 = state and Evenesce.Theme.Accent or Evenesce.Theme.Element
					check.ImageTransparency = state and 0 or 1
					check.Position = UDim2.fromOffset(2, state and 2 or 10)
					lbl.TextColor3 = state and Evenesce.Theme.Text or Evenesce.Theme.DimText
					if flag then Evenesce.Flags[flag] = state end
				end }
			end

			-- Slider
			function Section:Slider(sOpts)
				sOpts = sOpts or {}
				local min, max, def, float, suffix = sOpts.Min or 0, sOpts.Max or 100, sOpts.Default or 0, sOpts.Float or 1, sOpts.Suffix or ""
				local flag, cb = sOpts.Flag, sOpts.Callback
				def = math.clamp(def, min, max)

				local row = self:AddRow(48)
				local nameLbl = Instance.new("TextLabel")
				nameLbl.BackgroundTransparency = 1
				nameLbl.FontFace = FontMain
				nameLbl.Text = sOpts.Name or "Slider"
				nameLbl.TextColor3 = Evenesce.Theme.DimText
				nameLbl.TextSize = 14
				nameLbl.TextXAlignment = Enum.TextXAlignment.Left
				nameLbl.Position = UDim2.fromOffset(15, 4)
				nameLbl.Size = UDim2.new(1, -130, 0, 17)
				nameLbl.ZIndex = 7
				nameLbl.Parent = row.Instance

				local valLbl = Instance.new("TextLabel")
				valLbl.BackgroundTransparency = 1
				valLbl.FontFace = FontMain
				valLbl.Text = tostring(def) .. suffix
				valLbl.TextColor3 = Evenesce.Theme.Text
				valLbl.TextSize = 14
				valLbl.TextXAlignment = Enum.TextXAlignment.Right
				valLbl.Position = UDim2.new(1, -115, 0, 4)
				valLbl.Size = UDim2.fromOffset(100, 17)
				valLbl.ZIndex = 7
				valLbl.Parent = row.Instance

				local track = Instance.new("Frame")
				track.BackgroundColor3 = Evenesce.Theme.Element
				track.BorderSizePixel = 0
				track.Position = UDim2.fromOffset(15, 31)
				track.Size = UDim2.new(1, -30, 0, 7)
				track.ZIndex = 7
				track.Parent = row.Instance
				Corner(track, 1, 0)

				local fill = Instance.new("Frame")
				fill.BackgroundColor3 = Color3.new(1,1,1)
				fill.BorderSizePixel = 0
				fill.Size = UDim2.fromOffset(math.max(((def - min) / math.max(max - min, 0.0001)) * (self.Width - 30), 6), 7)
				fill.ZIndex = 8
				fill.Parent = track
				Corner(fill, 1, 0)

				local g = Instance.new("UIGradient")
				g.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Evenesce.Theme.Accent),
					ColorSequenceKeypoint.new(1, Evenesce.Theme.AccentDark)
				})
				g.Parent = fill

				local dragging = false
				local function update(x)
					local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
					local val = math.floor((min + (max - min) * rel) / float + 0.5) * float
					val = math.clamp(val, min, max)
					fill.Size = UDim2.fromOffset(math.max(rel * track.AbsoluteSize.X, 6), 7)
					valLbl.Text = tostring(val) .. suffix
					if flag then Evenesce.Flags[flag] = val end
					if cb then task.spawn(cb, val) end
					return val
				end

				Connect(track.InputBegan, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then
						dragging = true
						update(i.Position.X)
					end
				end)
				Connect(UserInputService.InputChanged, function(i)
					if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
						update(i.Position.X)
					end
				end)
				Connect(UserInputService.InputEnded, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
				end)

				if flag then Evenesce.Flags[flag] = def end
				return { Set = function(_, v)
					v = math.clamp(v, min, max)
					local rel = (v - min) / math.max(max - min, 0.0001)
					fill.Size = UDim2.fromOffset(math.max(rel * track.AbsoluteSize.X, 6), 7)
					valLbl.Text = tostring(v) .. suffix
					if flag then Evenesce.Flags[flag] = v end
				end }
			end

			-- Button
			function Section:Button(bOpts)
				bOpts = bOpts or {}
				local row = self:AddRow(46)
				local btn = Instance.new("Frame")
				btn.BackgroundColor3 = Evenesce.Theme.Element
				btn.BorderSizePixel = 0
				btn.Position = UDim2.fromOffset(15, 8)
				btn.Size = UDim2.new(1, -30, 0, 30)
				btn.ZIndex = 7
				btn.Parent = row.Instance
				Corner(btn, 0, 6)

				local lbl = Instance.new("TextLabel")
				lbl.BackgroundTransparency = 1
				lbl.FontFace = FontMain
				lbl.Text = bOpts.Name or "Button"
				lbl.TextColor3 = Evenesce.Theme.Text
				lbl.TextSize = 14
				lbl.Size = UDim2.fromScale(1, 1)
				lbl.ZIndex = 8
				lbl.Parent = btn

				local hit = Instance.new("TextButton")
				hit.BackgroundTransparency = 1
				hit.Text = ""
				hit.Size = UDim2.fromScale(1, 1)
				hit.ZIndex = 9
				hit.Parent = btn

				Connect(hit.MouseButton1Down, function()
					Ripple(btn)
					if bOpts.Callback then task.spawn(bOpts.Callback) end
				end)
			end

			-- Dropdown (single)
			function Section:Dropdown(dOpts)
				dOpts = dOpts or {}
				local options = dOpts.Options or {}
				local def = dOpts.Default or (options[1] and tostring(options[1]) or "None")
				local flag, cb = dOpts.Flag, dOpts.Callback

				local row = self:AddRow(64)
				local nameLbl = Instance.new("TextLabel")
				nameLbl.BackgroundTransparency = 1
				nameLbl.FontFace = FontMain
				nameLbl.Text = dOpts.Name or "Dropdown"
				nameLbl.TextColor3 = Evenesce.Theme.DimText
				nameLbl.TextSize = 14
				nameLbl.TextXAlignment = Enum.TextXAlignment.Left
				nameLbl.Position = UDim2.fromOffset(15, 4)
				nameLbl.Size = UDim2.new(1, -30, 0, 17)
				nameLbl.ZIndex = 7
				nameLbl.Parent = row.Instance

				local box = Instance.new("Frame")
				box.BackgroundColor3 = Evenesce.Theme.Element
				box.BorderSizePixel = 0
				box.Position = UDim2.fromOffset(15, 27)
				box.Size = UDim2.new(1, -30, 0, 30)
				box.ZIndex = 7
				box.Parent = row.Instance
				Corner(box, 0, 6)

				local valLbl = Instance.new("TextLabel")
				valLbl.BackgroundTransparency = 1
				valLbl.FontFace = FontMain
				valLbl.Text = tostring(def)
				valLbl.TextColor3 = Evenesce.Theme.Text
				valLbl.TextSize = 14
				valLbl.TextXAlignment = Enum.TextXAlignment.Left
				valLbl.TextTruncate = Enum.TextTruncate.AtEnd
				valLbl.Position = UDim2.fromOffset(12, 0)
				valLbl.Size = UDim2.new(1, -44, 1, 0)
				valLbl.ZIndex = 8
				valLbl.Parent = box

				local arrow = Instance.new("ImageLabel")
				arrow.BackgroundTransparency = 1
				arrow.Image = "rbxassetid://115907894584787"
				arrow.ImageColor3 = Evenesce.Theme.DimText
				arrow.Position = UDim2.new(1, -25, 0, 11)
				arrow.Size = UDim2.fromOffset(13, 9)
				arrow.ZIndex = 8
				arrow.Parent = box

				local open = false
				local drop = Instance.new("Frame")
				drop.BackgroundColor3 = Evenesce.Theme.Section
				drop.BorderSizePixel = 0
				drop.ClipsDescendants = true
				drop.Size = UDim2.fromOffset(0, 0)
				drop.Visible = false
				drop.ZIndex = 50
				drop.Parent = Holder
				Corner(drop, 0, 6)

				local list = Instance.new("ScrollingFrame")
				list.BackgroundTransparency = 1
				list.BorderSizePixel = 0
				list.ScrollBarThickness = 0
				list.AutomaticCanvasSize = Enum.AutomaticSize.Y
				list.Size = UDim2.fromScale(1, 1)
				list.ZIndex = 51
				list.Parent = drop

				local listLayout = Instance.new("UIListLayout")
				listLayout.SortOrder = Enum.SortOrder.LayoutOrder
				listLayout.Padding = UDim.new(0, 4)
				listLayout.Parent = list

				local listPad = Instance.new("UIPadding")
				listPad.PaddingTop = UDim.new(0, 6)
				listPad.PaddingBottom = UDim.new(0, 6)
				listPad.PaddingLeft = UDim.new(0, 6)
				listPad.PaddingRight = UDim.new(0, 6)
				listPad.Parent = list

				local function rebuild()
					for _, c in ipairs(list:GetChildren()) do
						if c:IsA("Frame") then c:Destroy() end
					end
					for _, opt in ipairs(options) do
						local item = Instance.new("Frame")
						item.BackgroundColor3 = Evenesce.Theme.ElementAlt
						item.BackgroundTransparency = 1
						item.BorderSizePixel = 0
						item.Size = UDim2.new(1, -8, 0, 30)
						item.ZIndex = 52
						item.Parent = list
						Corner(item, 0, 4)

						local t = Instance.new("TextLabel")
						t.BackgroundTransparency = 1
						t.FontFace = FontMain
						t.Text = tostring(opt)
						t.TextColor3 = Evenesce.Theme.DimText
						t.TextSize = 14
						t.TextXAlignment = Enum.TextXAlignment.Left
						t.Position = UDim2.fromOffset(12, 0)
						t.Size = UDim2.new(1, -20, 1, 0)
						t.ZIndex = 53
						t.Parent = item

						local hit = Instance.new("TextButton")
						hit.BackgroundTransparency = 1
						hit.Text = ""
						hit.Size = UDim2.fromScale(1, 1)
						hit.ZIndex = 54
						hit.Parent = item

						Connect(hit.MouseEnter, function() Tween(t, { TextColor3 = Evenesce.Theme.Text }, 0.15) end)
						Connect(hit.MouseLeave, function() Tween(t, { TextColor3 = Evenesce.Theme.DimText }, 0.15) end)
						Connect(hit.MouseButton1Down, function()
							valLbl.Text = tostring(opt)
							if flag then Evenesce.Flags[flag] = opt end
							if cb then task.spawn(cb, opt) end
							open = false
							drop.Visible = false
							Tween(arrow, { Rotation = 0 }, 0.2)
						end)
					end
				end
				rebuild()

				local hit = Instance.new("TextButton")
				hit.BackgroundTransparency = 1
				hit.Text = ""
				hit.Size = UDim2.fromScale(1, 1)
				hit.ZIndex = 9
				hit.Parent = box

				Connect(hit.MouseButton1Down, function()
					open = not open
					if open then
						local abs = box.AbsolutePosition
						local sz  = box.AbsoluteSize
						drop.Position = UDim2.fromOffset(abs.X, abs.Y + sz.Y + 4)
						drop.Size = UDim2.fromOffset(sz.X, math.min(180, #options * 34 + 12))
						drop.Visible = true
						Tween(arrow, { Rotation = 180 }, 0.2)
					else
						drop.Visible = false
						Tween(arrow, { Rotation = 0 }, 0.2)
					end
				end)

				if flag then Evenesce.Flags[flag] = def end
				return {
					Set = function(_, v)
						valLbl.Text = tostring(v)
						if flag then Evenesce.Flags[flag] = v end
					end,
					Refresh = function(_, newOpts)
						options = newOpts or options
						rebuild()
					end
				}
			end

			table.insert(self.Sections, Section)
			return Section
		end

		Connect(btn.MouseButton1Down, function()
			for _, t in ipairs(self.Tabs) do
				t.Page.Visible = false
				t.Button:FindFirstChildOfClass("TextLabel").TextColor3 = Evenesce.Theme.DimText
			end
			page.Visible = true
			lbl.TextColor3 = Evenesce.Theme.Text
			self.Current = Tab
		end)

		table.insert(self.Tabs, Tab)
		if #self.Tabs == 1 then
			page.Visible = true
			lbl.TextColor3 = Evenesce.Theme.Text
			self.Current = Tab
		end
		return Tab
	end

	table.insert(self.Windows, Window)
	return Window
end

-- ─── unload ─────────────────────────────────────────────────────────────────
function Evenesce:Unload()
	for _, c in ipairs(self.Connections) do
		pcall(function() c:Disconnect() end)
	end
	Holder:Destroy()
	Unused:Destroy()
	getgenv().Evenesce = nil
end

-- ─── expose ─────────────────────────────────────────────────────────────────
getgenv().Evenesce = Evenesce
return Evenesce
