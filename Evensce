local function ensureFont(name, url, weight)
	if isfile(name) then return end
	local data = game:HttpGet(url)
	writefile(name, data)
	local json = HttpService:JSONEncode({
		faces = {{
			assetId = "rbxasset://" .. name,
			name    = name:gsub("%.ttf$",""):gsub("-"," "),
			style   = "Regular",
			weight  = weight or 400
		}},
		name = name:gsub("%.ttf$","")
	})
	writefile("Evenesce/Assets/" .. name:gsub("%.ttf$",".font"), json)
end

