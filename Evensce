-- ─── utility ────────────────────────────────────────────────────────────────
local function Corner(parent, scale, offset)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale or 0, offset or 0)
	c.Parent = parent
	return c
end

local function Stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0,0,0)
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.Parent = parent
	return s
end

local function Tween(obj, props, duration, style, dir)
	local t = TweenService:Create(obj,
		TweenInfo.new(duration or Evenesce.Animation.Time,
			style or Evenesce.Animation.Style,
			dir or Evenesce.Animation.Direction),
		props)
	t:Play()
	return t
end

local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Evenesce.Connections, c)
	return c
end

local function Ripple(frame)
	frame.ClipsDescendants = true
	local mx, my = UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y - guiInset.Y
	local abs = frame.AbsolutePosition
	local size = frame.AbsoluteSize
	local relX = math.clamp((mx - abs.X) / math.max(size.X, 1), 0, 1)
	local relY = math.clamp((my - abs.Y) / math.max(size.Y, 1), 0, 1)

	local r = Instance.new("Frame")
	r.AnchorPoint = Vector2.new(0.5, 0.5)
	r.BackgroundColor3 = Evenesce.Theme.Ripple
	r.BackgroundTransparency = 0.5
	r.Position = UDim2.fromScale(relX, relY)
	r.Size = UDim2.fromOffset(0, 0)
	r.ZIndex = frame.ZIndex + 1
	r.BorderSizePixel = 0
	r.Parent = frame
	Corner(r, 1, 0)

	local max = math.max(size.X, size.Y) * 1.35
	Tween(r, { BackgroundTransparency = 1, Size = UDim2.fromOffset(max, max) }, 0.45, Enum.EasingStyle.Quad)
	task.delay(0.5, function() r:Destroy() end)
end

-- ─── theme helpers ──────────────────────────────────────────────────────────
function Evenesce:SetAccent(col)
	self.Theme.Accent = col
	self.Theme.AccentDark = col:Lerp(Color3.new(0,0,0), 0.35)
	self.Theme.Ripple = col:Lerp(Color3.new(1,1,1), 0.1)
	self.ThemeDirty = true
end

function Evenesce:SetPreset(name)
	local p = self.Presets[name]
	if not p then return end
	for k, v in pairs(p) do
		self.Theme[k] = v
	end
	self:SetAccent(p.Accent)
end

function Evenesce:SetUIScale(scale)
	self.UserScale = scale
	UIScale.Scale = scale
end

