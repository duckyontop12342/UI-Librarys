					local box = Instance.new("Frame")
					box.BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Element
					box.BorderSizePixel = 0
					box.Position = UDim2.fromOffset(0, 7)
					box.Size = UDim2.fromOffset(18, 18)
