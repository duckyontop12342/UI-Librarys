				local row = newRow(32)
				rowTitle(row, title, 120)
				local keyBtn = create("TextButton", { Size = UDim2.fromOffset(0, 26), Position = UDim2.fromScale(1, 0.5), AnchorPoint = Vector2.new(1, 0.5), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.Surface, Text = formatKeyName(currentKey), TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 12, AutoButtonColor = false, Parent = row })
				corner(keyBtn, 6)
				create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = keyBtn })

