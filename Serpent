			return label
		end

		local function register(flag, object)
			Library.Flags[flag] = object
			return object
		end

		local function attachColorPicker(targetRow, compTitle, props, rightOffset)
			props = props or {}
			local currentColor = props.Default or Color3.new(1, 1, 1)
			local currentAlpha = (props.Transparency or 100) / 100
			local hue, sat, val = currentColor:ToHSV()
			local callback = props.Callback or function() end
			local flag = props.Flag or string.format("%s/Colorpicker/%s", tabTitle, compTitle)

			local holder = create("Frame", { Size = UDim2.new(0, 250, 1, 0), Position = UDim2.new(1, -(rightOffset or 8), 0, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 10, Parent = targetRow })
			create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 12), Parent = holder })

			local pipetteBtn = create("TextButton", { Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Text = "", LayoutOrder = 1, ZIndex = 10, Parent = holder })
			local pipetteIcon = create("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = ICONS.Pipette, ImageColor3 = Theme.TextSecondary, ZIndex = 10, Parent = pipetteBtn })
			local colorBtn = create("TextButton", { Size = UDim2.fromOffset(18, 18), BackgroundColor3 = currentColor, Text = "", AutoButtonColor = false, LayoutOrder = 2, ZIndex = 10, Parent = holder })
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = colorBtn })
			local hexBox = create("TextBox", { Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 13, ClearTextOnFocus = false, LayoutOrder = 3, ZIndex = 10, Parent = holder })
			local alphaLabel = create("TextLabel", { Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 13, LayoutOrder = 4, ZIndex = 10, Parent = holder })

			local picker = create("Frame", { BackgroundColor3 = Theme.Main, BorderSizePixel = 0, Size = UDim2.fromOffset(220, 0), Visible = false, ClipsDescendants = true, ZIndex = 3000, Parent = screenGui })
			create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = picker })
			local pickerStroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = picker })
			create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), Parent = picker })
			create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5), Parent = picker })

			local colorMap = create("TextButton", { Size = UDim2.new(1, 0, 0, 120), BackgroundColor3 = Color3.fromHSV(hue, 1, 1), AutoButtonColor = false, Text = "", LayoutOrder = 1, ZIndex = 3001, Parent = picker })
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = colorMap })
			local satOverlay = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3002, Parent = colorMap })
			create("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = satOverlay })
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = satOverlay })
			local valOverlay = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 3003, Parent = colorMap })
			create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Parent = valOverlay })
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = valOverlay })
			local marker = create("Frame", { Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(sat, 1 - val), ZIndex = 3004, Parent = colorMap })
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = marker })
			create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = marker })

			local function makeSlider(name, order)
				local frame = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 35), LayoutOrder = order, ZIndex = 3001, Parent = picker })
				local nameLabel = create("TextLabel", { Text = name, Size = UDim2.new(1, -40, 0, 15), BackgroundTransparency = 1, Font = Theme.Font, TextSize = 12, TextColor3 = Theme.TextSecondary, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3001, Parent = frame })
				local valueLabel = create("TextLabel", { Text = "0", Size = UDim2.fromOffset(40, 15), Position = UDim2.new(1, -40, 0, 0), BackgroundTransparency = 1, Font = Theme.Font, TextSize = 12, TextColor3 = Theme.TextPrimary, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3001, Parent = frame })
				local track = create("TextButton", { BackgroundColor3 = Theme.Search, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 4), Text = "", AutoButtonColor = false, ZIndex = 3001, Parent = frame })
				create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = track })
				local fill = create("Frame", { BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent, ZIndex = 3002, Parent = track })
				create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = fill })
				return { Track = track, Fill = fill, Value = valueLabel, Name = nameLabel }
			end
			local hueSlider, alphaSlider = makeSlider("Hue", 2), makeSlider("Transparency", 3)

			bindTheme(function()
				pipetteIcon.ImageColor3 = Theme.TextSecondary
				hexBox.TextColor3 = Theme.TextPrimary
				alphaLabel.TextColor3 = Theme.TextSecondary
				picker.BackgroundColor3 = Theme.Main
				pickerStroke.Color = Theme.Border
				for _, s in ipairs({ hueSlider, alphaSlider }) do
					s.Track.BackgroundColor3 = Theme.Search
					s.Fill.BackgroundColor3 = Theme.Accent
					s.Value.TextColor3 = Theme.TextPrimary
					s.Name.TextColor3 = Theme.TextSecondary
				end
			end)

			local function refresh(fire)
				colorBtn.BackgroundColor3 = currentColor
				hexBox.Text = currentColor:ToHex():upper()
				alphaLabel.Text = math.floor(currentAlpha * 100) .. "%"
				colorMap.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
				tween(marker, TweenInfo.new(0.05), { Position = UDim2.fromScale(sat, 1 - val) })
				tween(hueSlider.Fill, TweenInfo.new(0.05), { Size = UDim2.new(hue, 0, 1, 0) })
				hueSlider.Value.Text = tostring(math.floor(hue * 360))
				tween(alphaSlider.Fill, TweenInfo.new(0.05), { Size = UDim2.new(currentAlpha, 0, 1, 0) })
				alphaSlider.Value.Text = math.floor(currentAlpha * 100) .. "%"
				if fire then callback(currentColor, currentAlpha * 100) end
			end

			hexBox.FocusLost:Connect(function()
				local ok, parsed = pcall(Color3.fromHex, hexBox.Text)
				if ok then
					currentColor = parsed
					hue, sat, val = parsed:ToHSV()
					refresh(true)
				else
					hexBox.Text = currentColor:ToHex():upper()
				end
			end)

			local function drag(guiObject, kind, input)
				local function update(position)
					local x = math.clamp((position.X - guiObject.AbsolutePosition.X) / guiObject.AbsoluteSize.X, 0, 1)
					local y = math.clamp((position.Y - guiObject.AbsolutePosition.Y) / guiObject.AbsoluteSize.Y, 0, 1)
					if kind == "Map" then
						sat, val = x, 1 - y
					elseif kind == "Hue" then
						hue = x
					else
						currentAlpha = x
					end
					currentColor = Color3.fromHSV(hue, sat, val)
					refresh(true)
				end
				update(input.Position)
				local moveConn, endConn
				moveConn = userInputService.InputChanged:Connect(function(move)
					if move.UserInputType == Enum.UserInputType.MouseMovement or move.UserInputType == Enum.UserInputType.Touch then
						update(move.Position)
					end
				end)
				endConn = userInputService.InputEnded:Connect(function(finish)
					if isPress(finish) then
						moveConn:Disconnect()
						endConn:Disconnect()
					end
				end)
			end
			colorMap.InputBegan:Connect(function(i) if isPress(i) then drag(colorMap, "Map", i) end end)
			hueSlider.Track.InputBegan:Connect(function(i) if isPress(i) then drag(hueSlider.Track, "Hue", i) end end)
			alphaSlider.Track.InputBegan:Connect(function(i) if isPress(i) then drag(alphaSlider.Track, "Alpha", i) end end)

			local open = false
			local popup = {}
			function popup.IsOpen() return open end
			function popup.Contains(position) return isInside(picker, position) or isInside(colorBtn, position) end
			function popup.Close()
				open = false
				local t = tween(picker, TWEEN_SMOOTH, { Size = UDim2.fromOffset(220, 0) })
				t.Completed:Once(function()
					if not open then picker.Visible = false end
				end)
			end
			table.insert(Window.Popups, popup)

			colorBtn.MouseButton1Click:Connect(function()
				if open then return popup.Close() end
				Window:ClosePopups(popup)
				local btnPos, screenSize = colorBtn.AbsolutePosition, screenGui.AbsoluteSize
				local x, y = btnPos.X - 230, btnPos.Y + 25
				if x < 0 then x = btnPos.X + 35 end
				if y + 225 > screenSize.Y then y = screenSize.Y - 230 end
				picker.Position = UDim2.fromOffset(x, y)
				picker.Visible = true
				open = true
				tween(picker, TWEEN_SMOOTH, { Size = UDim2.fromOffset(220, 225) })
			end)

			refresh(false)

			local object = {}
			function object:GetComponentType() return "Colorpicker" end
			function object:GetValue() return currentColor end
			function object:GetTransparency() return currentAlpha * 100 end
			function object:SetValue(color)
				currentColor = color
				hue, sat, val = color:ToHSV()
				refresh(true)
			end
			function object:SetTransparency(alpha)
				currentAlpha = math.clamp(alpha, 0, 100) / 100
				refresh(true)
			end
			return register(flag, object)
		end

		---Add a bare section header.
