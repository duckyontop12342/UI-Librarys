		function Tab:Keybind(opts)
			opts = opts or {}
			local title = opts.Title or "Keybind"
			local callback = opts.Callback or function() end
			local currentKey = opts.Default
			local binding = false
			local row = createRow(title, 40)
			createTitle(row, title)

			local keyContainer = create("TextButton", { Size = UDim2.new(0, 150, 1, 0), Position = UDim2.new(1, -8, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row })
			create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), Parent = keyContainer })
			local keyText = create("TextLabel", { Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = formatKeyName(currentKey), TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 13, LayoutOrder = 2, Parent = keyContainer })
			local iconHolder = create("Frame", { Size = UDim2.fromOffset(24, 18), BackgroundTransparency = 1, LayoutOrder = 1, Parent = keyContainer })
			local icon = create("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = ICONS.Keyboard, ImageColor3 = Theme.TextPrimary, Parent = iconHolder })

			local function paint()
				local color = binding and Theme.Accent or Theme.TextPrimary
				keyText.TextColor3 = color
				icon.ImageColor3 = color
			end
			bindTheme(paint)

			local function setValue(key, fire)
				currentKey = key
				keyText.Text = formatKeyName(key)
				binding = false
				paint()
				if fire then callback(key) end
			end

			keyContainer.MouseButton1Click:Connect(function()
				if binding then return end
				binding = true
				keyText.Text = "..."
				paint()
				local conn
				conn = userInputService.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.Keyboard then
						conn:Disconnect()
						if input.KeyCode == Enum.KeyCode.Escape then
							setValue(currentKey, false)
						else
							setValue(input.KeyCode, true)
						end
					elseif string.find(input.UserInputType.Name, "MouseButton") then
						conn:Disconnect()
						setValue(input.UserInputType, true)
					end
				end)
			end)

			-- Fire callback when the bound key is pressed outside of binding mode.
			track(userInputService.InputBegan:Connect(function(input, processed)
				if processed or binding or not currentKey then return end
				if input.KeyCode == currentKey or input.UserInputType == currentKey then
					callback(currentKey)
				end
			end))

			local object = { Row = row }
			function object:GetComponentType() return "Keybind" end
			function object:GetValue() return currentKey end
			function object:SetValue(key) setValue(key, true) end
			return register(opts.Flag or string.format("%s/Keybind/%s", tabTitle, title), object)
		end

		function Tab:Slider(opts)
			opts = opts or {}
			local title = opts.Title or "Slider"
			local min, max = opts.Min or 0, opts.Max or 100
			local decimal = opts.Decimal or 0
			local prefix, suffix = opts.Prefix or "", opts.Suffix or ""
			local dual = opts.Dual or false
			local zero = opts.ZeroNumber or min
			local callback = opts.Callback or function() end

			local current
			if dual then
				local d = type(opts.Default) == "table" and opts.Default or {}
				current = { math.clamp(d[1] or min, min, max), math.clamp(d[2] or max, min, max) }
			else
				current = math.clamp(opts.Default or min, min, max)
			end

			local row = createRow(title, 52)
			local titleLabel = create("TextLabel", { Size = UDim2.fromOffset(200, 20), Position = UDim2.fromOffset(8, 8), BackgroundTransparency = 1, Text = title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
			local valueLabel = create("TextLabel", { Size = UDim2.fromOffset(150, 20), Position = UDim2.new(1, -158, 0, 8), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
			local trackBtn = create("TextButton", { Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row })
			local track = create("Frame", { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2), BackgroundColor3 = Theme.Search, Parent = trackBtn })
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
			local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, Parent = track })
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
			local handle1 = create("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromScale(dual and 0 or 1, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.TextPrimary, Parent = fill })
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = handle1 })
			local handle2
			if dual then
				handle2 = create("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromScale(1, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.TextPrimary, Parent = fill })
				create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = handle2 })
			end

			bindTheme(function()
				titleLabel.TextColor3 = Theme.TextPrimary
				valueLabel.TextColor3 = Theme.TextPrimary
				track.BackgroundColor3 = Theme.Search
				fill.BackgroundColor3 = Theme.Accent
				handle1.BackgroundColor3 = Theme.TextPrimary
				if handle2 then handle2.BackgroundColor3 = Theme.TextPrimary end
			end)

			local function fmt(value)
				return string.format("%s%." .. decimal .. "f%s", prefix, value, suffix)
			end
			local function setText(value)
				if dual then
					valueLabel.Text = string.format("( %s, %s )", fmt(value[1]), fmt(value[2]))
				else
					valueLabel.Text = string.format("( %s )", fmt(value))
				end
			end

			local zeroAlpha = math.clamp((zero - min) / (max - min), 0, 1)
			local function visuals(value)
				setText(value)
				if dual then
					local a1, a2 = (value[1] - min) / (max - min), (value[2] - min) / (max - min)
					tween(fill, TWEEN_SMOOTH, { Position = UDim2.fromScale(a1, 0), Size = UDim2.fromScale(a2 - a1, 1) })
				else
					local a = (value - min) / (max - min)
					tween(fill, TWEEN_SMOOTH, { Position = UDim2.fromScale(math.min(a, zeroAlpha), 0), Size = UDim2.fromScale(math.abs(a - zeroAlpha), 1) })
					handle1.Position = UDim2.fromScale(a < zeroAlpha and 0 or 1, 0.5)
				end
			end

			local function setValue(value, fire)
				if dual then
					value = type(value) == "table" and value or { min, max }
					current = { math.clamp(value[1], min, max), math.clamp(value[2], min, max) }
				else
					current = math.clamp(value, min, max)
				end
				visuals(current)
				if fire then callback(current) end
			end

			local activeHandle = 1
			local function fromInput(input)
				local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				local mult = 10 ^ decimal
				local value = math.clamp(math.round((min + (max - min) * alpha) * mult) / mult, min, max)
				if dual then
					local new = { current[1], current[2] }
					new[activeHandle] = value
					if activeHandle == 1 and new[1] > new[2] then new[1] = new[2] end
					if activeHandle == 2 and new[2] < new[1] then new[2] = new[1] end
					setValue(new, true)
				else
					setValue(value, true)
				end
			end

			trackBtn.InputBegan:Connect(function(input)
				if not isPress(input) then return end
				if dual then
					local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
					local d1 = math.abs(alpha - (current[1] - min) / (max - min))
					local d2 = math.abs(alpha - (current[2] - min) / (max - min))
					activeHandle = (d1 == d2 and (alpha > (current[1] - min) / (max - min) and 2 or 1)) or (d1 < d2 and 1 or 2)
				end
				fromInput(input)
				local moveConn, endConn
				moveConn = userInputService.InputChanged:Connect(function(move)
					if move.UserInputType == Enum.UserInputType.MouseMovement or move.UserInputType == Enum.UserInputType.Touch then
						fromInput(move)
					end
				end)
				endConn = userInputService.InputEnded:Connect(function(finish)
					if isPress(finish) then
						moveConn:Disconnect()
						endConn:Disconnect()
					end
				end)
			end)

			visuals(current)
			local object = { Row = row }
			function object:GetComponentType() return "Slider" end
			function object:GetValue() return current end
			function object:SetValue(value) setValue(value, true) end
			return register(opts.Flag or string.format("%s/Slider/%s", tabTitle, title), object)
		end

		function Tab:Toggle(opts)
			opts = opts or {}
			local title = opts.Title or "Toggle"
			local callback = opts.Callback or function() end
			local state = opts.Default or false
			local row = createRow(title, 40)
			createTitle(row, title, 60)

			local box = create("TextButton", { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -8, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = state and Theme.Accent or Theme.Search, Text = "", AutoButtonColor = false, ZIndex = 6, Parent = row })
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = box })
			bindTheme(function() box.BackgroundColor3 = state and Theme.Accent or Theme.Search end)

			local function setState(value, fire)
				state = value and true or false
				tween(box, TWEEN_FAST, { BackgroundColor3 = state and Theme.Accent or Theme.Search })
				if fire then callback(state) end
			end

			-- Click layer sits under the colorpicker (ZIndex 10) so both stay usable.
			local clickLayer = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = row })
			clickLayer.MouseButton1Click:Connect(function() setState(not state, true) end)
			box.MouseButton1Click:Connect(function() setState(not state, true) end)

			local object = { Row = row }
			function object:GetComponentType() return "Toggle" end
			function object:GetValue() return state end
			function object:SetValue(value) setState(value, true) end
			function object:Colorpicker(props)
				attachColorPicker(row, title, props, 36)
				return self
			end
			return register(opts.Flag or string.format("%s/Toggle/%s", tabTitle, title), object)
		end

		function Tab:Dropdown(opts)
			opts = opts or {}
			local title = opts.Title or "Dropdown"
			local list = opts.Options or {}
			local multi = opts.Multi or false
			local callback = opts.Callback or function() end
			local selected = {}

			local default = opts.Default
			if multi then
				if type(default) == "table" then for _, v in ipairs(default) do table.insert(selected, v) end end
			elseif type(default) == "string" and default ~= "" then
				table.insert(selected, default)
			elseif type(default) == "table" and #default > 0 then
				table.insert(selected, default[1])
			end

			local row = createRow(title, 40)
			createTitle(row, title)
			local dropBtn = create("TextButton", { Size = UDim2.fromOffset(160, 26), Position = UDim2.new(1, -8, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = Theme.Search, Text = "", AutoButtonColor = false, Parent = row })
			create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = dropBtn })
			local dropText = create("TextLabel", { Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = dropBtn })
			local chevron = create("ImageLabel", { Size = UDim2.fromOffset(16, 16), Position = UDim2.new(1, -20, 0.5, -8), BackgroundTransparency = 1, Image = ICONS.ChevronDown, ImageColor3 = Theme.TextSecondary, Parent = dropBtn })

			local menu = create("ScrollingFrame", { Size = UDim2.fromOffset(160, 0), BackgroundColor3 = Theme.Main, Visible = false, ClipsDescendants = true, ZIndex = 4000, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Border, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = screenGui })
			create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = menu })
			local menuStroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = menu })
			create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = menu })
			local menuLayout = create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })

			local buttons, open, follow = {}, false, nil

			local function updateText()
				local text = table.concat(selected, ", ")
				if #text > 18 then text = string.sub(text, 1, 15) .. "..." end
				dropText.Text = text == "" and "None" or text
			end

			local function menuHeight()
				return math.min(menuLayout.AbsoluteContentSize.Y + 8, 160)
			end

			local popup = {}
			function popup.IsOpen() return open end
			function popup.Contains(position) return isInside(menu, position) or isInside(dropBtn, position) end
			function popup.Close()
				open = false
				tween(chevron, TWEEN_SMOOTH, { Rotation = 0 })
				local t = tween(menu, TWEEN_SMOOTH, { Size = UDim2.fromOffset(160, 0) })
				t.Completed:Once(function()
					if not open then
						menu.Visible = false
						if follow then follow:Disconnect() follow = nil end
					end
				end)
			end
			table.insert(Window.Popups, popup)

			local function paintOptions()
				for option, button in pairs(buttons) do
					button.TextColor3 = table.find(selected, option) and Theme.Accent or Theme.TextSecondary
				end
			end

			local function setValue(value, fire)
				selected = {}
				if multi then
					if type(value) == "table" then for _, v in ipairs(value) do table.insert(selected, v) end end
				elseif type(value) == "string" and value ~= "" then
					table.insert(selected, value)
				elseif type(value) == "table" and #value > 0 then
					table.insert(selected, value[1])
				end
				paintOptions()
				updateText()
				if fire then callback(multi and selected or selected[1]) end
			end

			local function setOptions(newList)
				list = type(newList) == "table" and newList or {}
				for _, button in pairs(buttons) do button:Destroy() end
				table.clear(buttons)
				local kept = {}
				for _, item in ipairs(selected) do
					if table.find(list, item) then table.insert(kept, item) end
				end
				selected = kept
				for index, option in ipairs(list) do
					local button = create("TextButton", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = option, TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = index, ZIndex = 4001, Parent = menu })
					create("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = button })
					buttons[option] = button
					button.MouseButton1Click:Connect(function()
						if multi then
							local copy = table.clone(selected)
							local at = table.find(copy, option)
							if at then table.remove(copy, at) else table.insert(copy, option) end
							setValue(copy, true)
						else
							setValue(option, true)
							popup.Close()
						end
					end)
				end
				paintOptions()
				updateText()
				if open then tween(menu, TWEEN_SMOOTH, { Size = UDim2.fromOffset(160, menuHeight()) }) end
			end
			setOptions(list)

			bindTheme(function()
				dropText.TextColor3 = Theme.TextPrimary
				chevron.ImageColor3 = Theme.TextSecondary
				dropBtn.BackgroundColor3 = Theme.Search
				menu.BackgroundColor3 = Theme.Main
				menuStroke.Color = Theme.Border
				paintOptions()
			end)

			dropBtn.MouseButton1Click:Connect(function()
				if open then return popup.Close() end
				Window:ClosePopups(popup)
				open = true
				menu.Visible = true
				tween(chevron, TWEEN_SMOOTH, { Rotation = 180 })
				tween(menu, TWEEN_SMOOTH, { Size = UDim2.fromOffset(160, menuHeight()) })
				follow = runService.RenderStepped:Connect(function()
					menu.Position = UDim2.fromOffset(dropBtn.AbsolutePosition.X, dropBtn.AbsolutePosition.Y + dropBtn.AbsoluteSize.Y + 6)
				end)
			end)

			local object = { Row = row }
			function object:GetComponentType() return "Dropdown" end
			function object:GetValue() return multi and selected or selected[1] end
			function object:SetValue(value) setValue(value, true) end
			function object:SetOptions(newList) setOptions(newList) end
			function object:GetOptions() return list end
			return register(opts.Flag or string.format("%s/Dropdown/%s", tabTitle, title), object)
		end

		return Tab
	end

	Window.ConfigTab = Window:Tab({ Title = "Configuration", Icon = ICONS.Save, IsConfig = true })

	---Fill the config tab with save/load/delete, UI keybind and unload controls.
	---@param folder string
	function Window:SetupConfig(folder)
		folder = folder or "serpent"
		if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end

		local tab = self.ConfigTab
		local function getList()
			local names = {}
			if listfiles then
				for _, path in ipairs(listfiles(folder)) do
					local name = path:match("([^/\\]+)%.json$")
					if name then table.insert(names, name) end
				end
			end
			return names
		end

		tab:Section("Configs")
		local dropdown = tab:Dropdown({ Title = "Configs", Options = getList(), Flag = "Config_List" })
		local nameBox = tab:Textbox({ Title = "Config name", Placeholder = "myconfig", Flag = "Config_Name" })
		tab:Button({ Title = "Load config", Action = "Load", Callback = function()
			local name = dropdown:GetValue()
			if not name then return self:Notify({ Title = "Config", Content = "Select a config first." }) end
			local ok = Library:LoadFlags(readfile(string.format("%s/%s.json", folder, name)))
			self:Notify({ Title = "Config", Content = ok and ("Loaded " .. name) or "Failed to load config." })
		end })
		tab:Button({ Title = "Save config", Action = "Save", Callback = function()
			local name = nameBox:GetValue()
			if name == "" then return self:Notify({ Title = "Config", Content = "Enter a config name." }) end
			writefile(string.format("%s/%s.json", folder, name), Library:SerializeFlags())
			dropdown:SetOptions(getList())
			self:Notify({ Title = "Config", Content = "Saved " .. name })
		end })
		tab:Button({ Title = "Delete config", Action = "Delete", Callback = function()
			local name = dropdown:GetValue()
			if not name then return end
			delfile(string.format("%s/%s.json", folder, name))
			dropdown:SetOptions(getList())
			self:Notify({ Title = "Config", Content = "Deleted " .. name })
		end })
		tab:Button({ Title = "Refresh list", Action = "Refresh", Callback = function() dropdown:SetOptions(getList()) end })

		tab:Section("Interface")
		tab:Keybind({ Title = "Toggle window", Default = Library.ToggleKey, Flag = "Config_ToggleKey", Callback = function(key)
			if key.EnumType == Enum.KeyCode then Library:SetWindowKeybind(key) end
		end })
		tab:Button({ Title = "Unload", Action = "Unload", Callback = function() Library:Unload() end })
	end

	return Window
end

return Library
