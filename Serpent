			---Row of pill buttons with an optional checkbox on the right.
			function H:Pills(opts)
				opts = opts or {}
				local options = opts.Options or {}
				local callback = opts.Callback or function() end
				local current = opts.Default or options[1]
				local row = newRow(34)
				local holder = create("Frame", { Size = UDim2.new(1, opts.Checkbox and -34 or 0, 1, 0), BackgroundTransparency = 1, Parent = row })
				create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = holder })

				local pills = {}
				local function paint()
					for name, pill in pairs(pills) do
						local active = name == current
						pill.BackgroundTransparency = active and 0 or 1
						pill.BackgroundColor3 = Theme.Accent
						pill.TextColor3 = active and Theme.AccentText or Theme.TextSecondary
					end
				end
				bindTheme(paint)

				local function setValue(value, fire)
					if not pills[value] then return end
					current = value
					paint()
					if fire then callback(current) end
				end

				for index, name in ipairs(options) do
					local pill = create("TextButton", { Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, Text = name, Font = Theme.Font, TextSize = 12, AutoButtonColor = false, LayoutOrder = index, BackgroundColor3 = Theme.Accent, Parent = holder })
					corner(pill, 14)
					create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = pill })
					pills[name] = pill
					pill.MouseButton1Click:Connect(function() setValue(name, true) end)
				end
				paint()

				local check
				if opts.Checkbox then
					local box = create("Frame", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromScale(1, 0.5), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Parent = row })
					check = makeCheck(box, opts.CheckboxDefault, opts.OnCheck)
				end

				local object = { Row = row }
				function object:GetComponentType() return "Pills" end
				function object:GetValue() return current end
				function object:SetValue(value) setValue(value, true) end
				function object:GetChecked() return check and check.Get() end
				function object:SetChecked(value) if check then check.Set(value, true) end end
				return register(flagName(opts, "Pills", opts.Title or "Pills"), object)
			end

			---Body silhouette with a compact dropdown. Parts: Head, Chest, Stomach, Arms, Legs.
			function H:BodySelector(opts)
				opts = opts or {}
				local parts = opts.Parts or { "Head", "Chest", "Stomach", "Arms", "Legs" }
				local callback = opts.Callback or function() end
				local current = opts.Default or "Chest"

				local row = newRow(224)
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = row })
				local moveDot
				local drop = buildDropdown(Window, row, { Options = parts, Default = current, Width = 88, Callback = function(value)
					current = value
					if moveDot then moveDot(value, 1) end
					callback(value)
				end }, true)
				drop.Button.LayoutOrder = 1

				local panel = create("Frame", { Size = UDim2.fromOffset(128, 190), BackgroundColor3 = Theme.Surface, LayoutOrder = 2, Parent = row })
				corner(panel, 8)

				local shapes = {
					Head = { { 51, 24, 26, 26, 13 } },
					Chest = { { 42, 56, 44, 28, 6 } },
					Stomach = { { 42, 86, 44, 28, 6 } },
					Arms = { { 26, 58, 12, 56, 6 }, { 90, 58, 12, 56, 6 } },
					Legs = { { 43, 118, 20, 64, 6 }, { 65, 118, 20, 64, 6 } },
				}
				local base, hover = Color3.fromRGB(95, 95, 95), Color3.fromRGB(135, 135, 135)

				local dot = create("Frame", { Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.Accent, ZIndex = 5, Parent = panel })
				corner(dot, 4)

				local frames = {}
				function moveDot(part, index)
					local spec = shapes[part] and shapes[part][index or 1]
					if not spec then return end
					tween(dot, TWEEN_FAST, { Position = UDim2.fromOffset(spec[1] + spec[3] / 2, spec[2] + spec[4] / 2) })
				end

				for _, part in ipairs(parts) do
					for index, spec in ipairs(shapes[part] or {}) do
						local piece = create("TextButton", { Position = UDim2.fromOffset(spec[1], spec[2]), Size = UDim2.fromOffset(spec[3], spec[4]), BackgroundColor3 = base, Text = "", AutoButtonColor = false, Parent = panel })
						corner(piece, spec[5])
						table.insert(frames, piece)
						piece.MouseEnter:Connect(function() tween(piece, TWEEN_FAST, { BackgroundColor3 = hover }) end)
						piece.MouseLeave:Connect(function() tween(piece, TWEEN_FAST, { BackgroundColor3 = base }) end)
						piece.MouseButton1Click:Connect(function()
							drop:SetValue(part)
							moveDot(part, index)
						end)
					end
				end

				bindTheme(function()
					panel.BackgroundColor3 = Theme.Surface
					dot.BackgroundColor3 = Theme.Accent
				end)
				task.defer(function() moveDot(current, 1) end)

				local object = { Row = row }
				function object:GetComponentType() return "BodySelector" end
				function object:GetValue() return current end
				function object:SetValue(value) drop:SetValue(value) end
				return register(flagName(opts, "Body", opts.Title or "Body"), object)
			end

			function H:Colorpicker(opts)
				opts = opts or {}
				local title = opts.Title or "Colorpicker"
				local row = newRow(30)
				rowTitle(row, title, 180)
				local object = attachColorPicker(row, title, opts, 0)
				object.Row = row
				return object
			end

			---Two side-by-side columns. Returns left, right holders with the same component methods.
			function H:Split(opts)
				opts = opts or {}
				local leftWidth, gap = opts.LeftWidth or 128, opts.Gap or 20
				H._order += 1
				local row = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = H._order, Parent = container })
				create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
				local function column(width, order)
					local frame = create("Frame", { Size = width, AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order, Parent = row })
					create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 12), Parent = frame })
					return attach({}, frame)
				end
				return column(UDim2.fromOffset(leftWidth, 0), 1), column(UDim2.new(1, -(leftWidth + gap), 0, 0), 2)
			end

			return H
		end

		return attach(Tab, page)
	end

	---Fill a Config tab with save/load/delete, UI keybind and unload controls.
	function Window:SetupConfig(folder)
		folder = folder or "serpent"
		if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end

		local tab = self:Tab({ Title = "Config" })
		self.ConfigTab = tab
		local function getList()
			local names = {}
			if listfiles then
				for _, path in ipairs(listfiles(folder)) do
					local name = path:match("([^/\\]+)%.json$")
					if name then table.insert(names, name) end
				end
			end
			return names
		end

		tab:Section("Configs")
		local dropdown = tab:Dropdown({ Title = "Select config", Options = getList(), Flag = "Config_List", Width = 190 })
		local nameBox = tab:Textbox({ Title = "Config name", Placeholder = "myconfig", Flag = "Config_Name" })
		tab:Button({ Title = "Load config", Action = "Load", Callback = function()
			local name = dropdown:GetValue()
			if not name then return self:Notify({ Title = "Config", Content = "Select a config first." }) end
			local ok = Library:LoadFlags(readfile(string.format("%s/%s.json", folder, name)))
			self:Notify({ Title = "Config", Content = ok and ("Loaded " .. name) or "Failed to load config." })
		end })
		tab:Button({ Title = "Save config", Action = "Save", Callback = function()
			local name = nameBox:GetValue()
			if name == "" then return self:Notify({ Title = "Config", Content = "Enter a config name." }) end
			writefile(string.format("%s/%s.json", folder, name), Library:SerializeFlags())
			dropdown:SetOptions(getList())
			self:Notify({ Title = "Config", Content = "Saved " .. name })
		end })
		tab:Button({ Title = "Delete config", Action = "Delete", Callback = function()
			local name = dropdown:GetValue()
			if not name then return end
			delfile(string.format("%s/%s.json", folder, name))
			dropdown:SetOptions(getList())
			self:Notify({ Title = "Config", Content = "Deleted " .. name })
		end })
		tab:Divider()
		tab:Keybind({ Title = "Toggle window", Default = Library.ToggleKey, Flag = "Config_ToggleKey", Callback = function(key)
			if key.EnumType == Enum.KeyCode then Library:SetWindowKeybind(key) end
		end })
		tab:Button({ Title = "Unload", Action = "Unload", Callback = function() Library:Unload() end })
		return tab
	end

	return Window
end

return Library
