					input.BackgroundColor3 = Theme.Surface
					input.TextColor3 = Theme.TextPrimary
					input.PlaceholderColor3 = Theme.TextSecondary
					stroke.Color = Theme.Border
				end)
				local function setValue(value, fire)
					current = tostring(value)
					input.Text = current
					if fire then callback(current) end
				end
				input.Focused:Connect(function()
					tween(stroke, TWEEN_FAST, { Color = Theme.Accent, Transparency = 0 })
					tween(input, TWEEN_SMOOTH, { Size = UDim2.fromOffset(160, 28) })
				end)
				input.FocusLost:Connect(function()
					tween(stroke, TWEEN_FAST, { Color = Theme.Border, Transparency = 0.4 })
					tween(input, TWEEN_SMOOTH, { Size = UDim2.fromOffset(130, 28) })
					setValue(input.Text, true)
				end)
				local object = { Row = row }
				function object:GetComponentType() return "Textbox" end
				function object:GetValue() return current end
				function object:SetValue(value) setValue(value, true) end
				return register(flagName(opts, "Textbox", title), object)
			end

			function H:Keybind(opts)
				opts = opts or {}
				local title = opts.Title or "Keybind"
				local callback = opts.Callback or function() end
				local currentKey = opts.Default
				local binding = false
				local row = newRow(32)
				rowTitle(row, title, 120)
				local keyBtn = create("TextButton", { Size = UDim2.fromOffset(0, 26), Position = UDim2.fromScale(1, 0.5), AnchorPoint = Vector2.new(1, 0.5), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.Surface, Text = formatKeyName(currentKey), TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 12, AutoButtonColor = false, Parent = row })
				corner(keyBtn, 6)
				local stroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Transparency = 0.4, Parent = keyBtn })
				create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = keyBtn })
				addPress(keyBtn, 0.95)
				addHover(keyBtn, function() return Theme.Surface end, function() return lighten(Theme.Surface, 0.07) end)

				local function paint()
					keyBtn.BackgroundColor3 = Theme.Surface
					keyBtn.TextColor3 = binding and Theme.Accent or Theme.TextPrimary
					stroke.Color = binding and Theme.Accent or Theme.Border
					stroke.Transparency = binding and 0 or 0.4
				end
				bindTheme(paint)

				local function setValue(key, fire)
					currentKey = key
					binding = false
					keyBtn.Text = formatKeyName(key)
					paint()
					if fire then callback(key) end
				end

				keyBtn.MouseButton1Click:Connect(function()
					if binding then return end
					binding = true
					keyBtn.Text = "..."
					paint()
					local conn
					conn = userInputService.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.Keyboard then
							conn:Disconnect()
							if input.KeyCode == Enum.KeyCode.Escape then setValue(currentKey, false) else setValue(input.KeyCode, true) end
						elseif string.find(input.UserInputType.Name, "MouseButton") then
							conn:Disconnect()
							setValue(input.UserInputType, true)
						end
					end)
				end)

				track(userInputService.InputBegan:Connect(function(input, processed)
					if processed or binding or not currentKey then return end
					if input.KeyCode == currentKey or input.UserInputType == currentKey then callback(currentKey) end
				end))

				local object = { Row = row }
				function object:GetComponentType() return "Keybind" end
				function object:GetValue() return currentKey end
				function object:SetValue(key) setValue(key, true) end
				return register(flagName(opts, "Keybind", title), object)
			end

			function H:Toggle(opts)
				opts = opts or {}
				local title = opts.Title or "Toggle"
				local callback = opts.Callback or function() end
				local row = newRow(30)
				local label = rowTitle(row, title, 60)
