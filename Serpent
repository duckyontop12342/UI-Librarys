			---Row of pill buttons with a sliding highlight and an optional checkbox on the right.
			function H:Pills(opts)
				opts = opts or {}
				local options = opts.Options or {}
				local callback = opts.Callback or function() end
				local current = opts.Default or options[1]
				local pillWidth = opts.PillWidth or 56
				local pillHeight = opts.PillHeight or 28
				local pillGap = opts.Gap or 4

				local row = newRow(pillHeight)
				local holder = create("Frame", { Size = UDim2.new(1, opts.Checkbox and -24 or 0, 1, 0), BackgroundTransparency = 1, Parent = row })

				local indicator = create("Frame", { Size = UDim2.fromOffset(pillWidth, pillHeight), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = holder })
				corner(indicator, pillHeight / 2)
				local indicatorScale = create("UIScale", { Parent = indicator })

				local pills = {}
				local function indexOf(name) return table.find(options, name) or 1 end
				local function paint(animate)
					local target = UDim2.fromOffset((indexOf(current) - 1) * (pillWidth + pillGap), 0)
					indicator.BackgroundColor3 = Theme.Accent
					if animate then tween(indicator, TWEEN_OPEN, { Position = target }) else indicator.Position = target end
					for name, pill in pairs(pills) do
						local goal = { TextColor3 = name == current and Theme.AccentText or Theme.TextSecondary }
						if animate then tween(pill, TWEEN_SMOOTH, goal) else pill.TextColor3 = goal.TextColor3 end
					end
				end
				bindTheme(function() paint(false) end)

				local function setValue(value, fire)
					if not pills[value] or value == current then return end
					current = value
					paint(true)
					indicatorScale.Scale = 0.9
					tween(indicatorScale, TWEEN_POP, { Scale = 1 })
					if fire then callback(current) end
				end

				for order, name in ipairs(options) do
					local pill = create("TextButton", { Size = UDim2.fromOffset(pillWidth, pillHeight), Position = UDim2.fromOffset((order - 1) * (pillWidth + pillGap), 0), BackgroundTransparency = 1, Text = name, Font = Theme.Font, TextSize = 12, AutoButtonColor = false, Parent = holder })
					pills[name] = pill
					addPress(pill, 0.94)
					pill.MouseEnter:Connect(function()
						if name ~= current then tween(pill, TWEEN_FAST, { TextColor3 = Theme.TextPrimary }) end
					end)
					pill.MouseLeave:Connect(function()
						if name ~= current then tween(pill, TWEEN_FAST, { TextColor3 = Theme.TextSecondary }) end
					end)
					pill.MouseButton1Click:Connect(function() setValue(name, true) end)
				end
				paint(false)

				local check
				if opts.Checkbox then
					local box = create("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromScale(1, 0.5), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Parent = row })
					check = makeCheck(box, opts.CheckboxDefault, opts.OnCheck, 14)
				end

				local object = { Row = row }
				function object:GetComponentType() return "Pills" end
				function object:GetValue() return current end
				function object:SetValue(value) setValue(value, true) end
				function object:GetChecked() return check and check.Get() end
				function object:SetChecked(value) if check then check.Set(value, true) end end
				return register(flagName(opts, "Pills", opts.Title or "Pills"), object)
			end

			---Lucide person silhouette with clickable zones and a compact dropdown. Parts: Head, Chest, Stomach, Arms, Legs.
			function H:BodySelector(opts)
				opts = opts or {}
				local parts = opts.Parts or { "Head", "Chest", "Stomach", "Arms", "Legs" }
				local callback = opts.Callback or function() end
				local current = opts.Default or parts[1]
				local currentIndex = 1

				local PANEL_W, PANEL_H, ICON = 129, 171, 120
				local K = ICON / 24
				local origin = Vector2.new((PANEL_W - ICON) / 2, (PANEL_H - ICON) / 2)
				local FIGURE = Color3.fromRGB(92, 92, 98)

				-- Zones are authored on the 24x24 Lucide person-standing grid.
				local zones = {
					Head = { { rect = { 9.7, 2.7, 4.6, 4.6 }, dot = { 12, 5 }, radius = 20 } },
					Chest = { { rect = { 8.6, 8, 6.8, 3.6 }, dot = { 12, 10 }, radius = 8 } },
					Stomach = { { rect = { 9.4, 11.8, 5.2, 3 }, dot = { 12, 13.2 }, radius = 8 } },
					Arms = {
						{ rect = { 4.8, 6.2, 4.2, 4.2 }, dot = { 7, 8.4 }, radius = 8 },
						{ rect = { 15, 6.2, 4.2, 4.2 }, dot = { 17, 8.4 }, radius = 8 },
					},
					Legs = {
						{ rect = { 7.6, 14.6, 4.2, 6 }, dot = { 9.8, 17.4 }, radius = 8 },
						{ rect = { 12.2, 14.6, 4.2, 6 }, dot = { 14.2, 17.4 }, radius = 8 },
					},
				}

				local row = newRow(205)
				local pendingIndex
				local moveDot

				local drop = buildDropdown(Window, row, { Options = parts, Default = current, Width = 88, Callback = function(value)
					current = value
					currentIndex = pendingIndex or 1
					pendingIndex = nil
					if moveDot then moveDot(true) end
					callback(value)
				end }, true)
				drop.Button.Position = UDim2.fromOffset(0, 0)

				local panel = create("Frame", { Size = UDim2.fromOffset(PANEL_W, PANEL_H), Position = UDim2.fromOffset(0, 34), BackgroundColor3 = Theme.Surface, ClipsDescendants = true, Parent = row })
				corner(panel, 9)

				local figure = create("ImageLabel", { Size = UDim2.fromOffset(ICON, ICON), Position = UDim2.fromOffset(origin.X, origin.Y), BackgroundTransparency = 1, ImageColor3 = FIGURE, Parent = panel })
				setIcon(figure, Library.Icons.Body)

				local zoneButtons = {}
				local function paintZones()
					for part, list in pairs(zoneButtons) do
						for _, button in ipairs(list) do
							tween(button, TWEEN_SMOOTH, { BackgroundTransparency = part == current and 0.88 or 1 })
						end
					end
				end

				for _, part in ipairs(parts) do
					zoneButtons[part] = {}
					for index, zone in ipairs(zones[part] or {}) do
						local r = zone.rect
						local button = create("TextButton", { Position = UDim2.fromOffset(origin.X + r[1] * K, origin.Y + r[2] * K), Size = UDim2.fromOffset(r[3] * K, r[4] * K), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = part == current and 0.88 or 1, Text = "", AutoButtonColor = false, Parent = panel })
						corner(button, zone.radius)
						table.insert(zoneButtons[part], button)
						button.MouseEnter:Connect(function()
							if part ~= current then tween(button, TWEEN_FAST, { BackgroundTransparency = 0.93 }) end
						end)
						button.MouseLeave:Connect(function()
							if part ~= current then tween(button, TWEEN_FAST, { BackgroundTransparency = 1 }) end
						end)
						button.MouseButton1Click:Connect(function()
							if part == current then
								currentIndex = index
								moveDot(true)
							else
								pendingIndex = index
								drop:SetValue(part)
							end
						end)
					end
				end

				local ring = create("Frame", { Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 4, Parent = panel })
				corner(ring, 20)
				local ringStroke = create("UIStroke", { Color = Theme.Accent, Thickness = 2, Transparency = 1, Parent = ring })
				local dot = create("Frame", { Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.Accent, ZIndex = 5, Parent = panel })
				corner(dot, 4)
				local dotScale = create("UIScale", { Parent = dot })

				local function dotTarget()
					local list = zones[current] or {}
					local zone = list[currentIndex] or list[1]
					if not zone then return nil end
					return UDim2.fromOffset(origin.X + zone.dot[1] * K, origin.Y + zone.dot[2] * K)
				end

				function moveDot(animate)
					local target = dotTarget()
					if not target then return end
					if animate then
						tween(dot, TWEEN_POP, { Position = target })
						dotScale.Scale = 1.7
						tween(dotScale, TWEEN_POP, { Scale = 1 })
						ring.Position = target
						ring.Size = UDim2.fromOffset(8, 8)
						ringStroke.Transparency = 0.15
						tween(ring, TWEEN_SLOW, { Size = UDim2.fromOffset(36, 36) })
						tween(ringStroke, TWEEN_SLOW, { Transparency = 1 })
						paintZones()
					else
						dot.Position = target
					end
				end
				moveDot(false)

				bindTheme(function()
					panel.BackgroundColor3 = Theme.Surface
					dot.BackgroundColor3 = Theme.Accent
					ringStroke.Color = Theme.Accent
				end)

				local object = { Row = row }
				function object:GetComponentType() return "BodySelector" end
				function object:GetValue() return current end
				function object:SetValue(value) drop:SetValue(value) end
				return register(flagName(opts, "Body", opts.Title or "Body"), object)
			end

			function H:Colorpicker(opts)
				opts = opts or {}
				local title = opts.Title or "Colorpicker"
				local row = newRow(30)
				rowTitle(row, title, 180)
				local object = attachColorPicker(row, title, opts, 0)
				object.Row = row
				return object
			end

			---Two side-by-side columns. Returns left, right holders with the same component methods.
			function H:Split(opts)
				opts = opts or {}
				local leftWidth, gap = opts.LeftWidth or 129, opts.Gap or 19
				local columnPadding = opts.Padding or 12
				H._order += 1
				local row = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = H._order, Parent = container })
				create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
				local function column(width, order)
					local frame = create("Frame", { Size = width, AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order, Parent = row })
					create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, columnPadding), Parent = frame })
					return attach({}, frame, columnPadding)
				end
				return column(UDim2.fromOffset(leftWidth, 0), 1), column(UDim2.new(1, -(leftWidth + gap), 0, 0), 2)
			end

			return H
		end

		return attach(Tab, page, pagePadding)
	end

	---Fill a Config tab with save/load/delete, UI keybind and unload controls.
	function Window:SetupConfig(folder)
		folder = folder or "serpent"
		if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end

		local tab = self:Tab({ Title = "Config", Icon = "user" })
		self.ConfigTab = tab
		local function getList()
			local names = {}
			if listfiles then
				for _, path in ipairs(listfiles(folder)) do
					local name = path:match("([^/\\]+)%.json$")
					if name then table.insert(names, name) end
				end
			end
			return names
		end

		tab:Section("Configs")
		local dropdown = tab:Dropdown({ Title = "Select config", Options = getList(), Flag = "Config_List", Width = 190 })
		local nameBox = tab:Textbox({ Title = "Config name", Placeholder = "myconfig", Flag = "Config_Name" })
		tab:Button({ Title = "Load config", Action = "Load", Callback = function()
			local name = dropdown:GetValue()
			if not name then return self:Notify({ Title = "Config", Content = "Select a config first." }) end
			local ok = Library:LoadFlags(readfile(string.format("%s/%s.json", folder, name)))
			self:Notify({ Title = "Config", Content = ok and ("Loaded " .. name) or "Failed to load config." })
		end })
		tab:Button({ Title = "Save config", Action = "Save", Callback = function()
			local name = nameBox:GetValue()
			if name == "" then return self:Notify({ Title = "Config", Content = "Enter a config name." }) end
			writefile(string.format("%s/%s.json", folder, name), Library:SerializeFlags())
			dropdown:SetOptions(getList())
			self:Notify({ Title = "Config", Content = "Saved " .. name })
		end })
		tab:Button({ Title = "Delete config", Action = "Delete", Callback = function()
			local name = dropdown:GetValue()
			if not name then return end
			delfile(string.format("%s/%s.json", folder, name))
			dropdown:SetOptions(getList())
			self:Notify({ Title = "Config", Content = "Deleted " .. name })
		end })
		tab:Divider()
		tab:Keybind({ Title = "Toggle window", Default = Library.ToggleKey, Flag = "Config_ToggleKey", Callback = function(key)
			if key.EnumType == Enum.KeyCode then Library:SetWindowKeybind(key) end
		end })
		tab:Button({ Title = "Unload", Action = "Unload", Callback = function() Library:Unload() end })
		return tab
	end

	return Window
end

return Library
