---Load Lucide with its file cache redirected into a folder named after the sprite-sheet version.
---A reused path lets the client keep serving an old sheet against the new name list, which
---shows up as every icon being the wrong one.
local function loadLucide()
	local source = game:HttpGet(LUCIDE_URL)
	local version = source:match('~= "([^"]+)"') or "unknown"
	local folder = "serpent/lucide_" .. (version:gsub("[^%w]", "_"))

	if writefile and isfolder and makefolder and getcustomasset and not isfolder("serpent") then
		makefolder("serpent")
	end

	local function redirect(path)
		if type(path) ~= "string" then return path end
		return (path:gsub("^lucide%-icons", function() return folder end))
	end
	local function wrap(fn)
		if not fn then return nil end
		return function(path, ...) return fn(redirect(path), ...) end
	end

	-- Locals shadow the executor globals for the module without touching its source.
	local prefix = "local __r = ...\nlocal isfolder, makefolder, isfile, readfile, writefile, getcustomasset = __r.isfolder, __r.makefolder, __r.isfile, __r.readfile, __r.writefile, __r.getcustomasset\n"
	local chunk = loadstring(prefix .. source)
	return chunk({
		isfolder = wrap(isfolder),
		makefolder = wrap(makefolder),
		isfile = wrap(isfile),
		readfile = wrap(readfile),
		writefile = wrap(writefile),
		getcustomasset = wrap(getcustomasset),
	})
end

-- Lucide's runtime sheet is only a fallback for names missing from the embedded atlas.
local lucideTried = false
local function getLucide()
	if lucideTried then return Library.Lucide end
	lucideTried = true
	local ok, result = pcall(loadLucide)
	if ok then Library.Lucide = result else warn("Serpent: Lucide failed to load. " .. tostring(result)) end
	return Library.Lucide
end

-- Embedded atlas rendered from Lucide's SVGs; immune to stale sheet caches.
local ATLAS_HASH = "9d371feee3"
local ATLAS_BYTES = 37266
local ATLAS_RECTS = {["chevron-down"]={0,0,64,64},["chevron-up"]={64,0,64,64},["check"]={128,0,64,64},["x"]={192,0,64,64},["settings"]={256,0,64,64},["plus"]={320,0,64,64},["minus"]={384,0,64,64},["search"]={448,0,64,64},["mouse"]={0,64,64,64},["shield"]={64,64,64,64},["user"]={128,64,64,64},["crosshair"]={192,64,64,64},["target"]={256,64,64,64},["eye"]={320,64,64,64},["sliders-horizontal"]={384,64,64,64},["wrench"]={448,64,64,64},["zap"]={0,128,64,64},["sword"]={64,128,64,64},["swords"]={128,128,64,64},["palette"]={192,128,64,64},["folder"]={256,128,64,64},["save"]={320,128,64,64},["keyboard"]={384,128,64,64},["bell"]={448,128,64,64},["star"]={0,192,64,64},["skull"]={64,192,64,64},["ghost"]={128,192,64,64},["flame"]={192,192,64,64},["bug"]={256,192,64,64},["cpu"]={320,192,64,64},["globe"]={384,192,64,64},["lock"]={448,192,64,64},["key"]={0,256,64,64},["house"]={64,256,64,64},["circle"]={128,256,64,64},["cog"]={192,256,64,64},["person-standing"]={0,320,144,144}}
local ATLAS_B64 = ""

local atlasAsset
local function getAtlas()
	if atlasAsset ~= nil then return atlasAsset or nil end
	atlasAsset = false
	local decode = (crypt and crypt.base64decode) or base64decode or base64_decode
	if not (decode and writefile and readfile and isfile and getcustomasset and makefolder and isfolder) then return nil end
	if not isfolder("serpent") then makefolder("serpent") end
	local path = "serpent/icons_" .. ATLAS_HASH .. ".png"
	local valid = false
	if isfile(path) then
		local ok, data = pcall(readfile, path)
		valid = ok and #data == ATLAS_BYTES
	end
	if not valid then
		local ok, bytes = pcall(decode, ATLAS_B64)
		if not ok then return nil end
		writefile(path, bytes)
	end
	local ok, asset = pcall(getcustomasset, path)
	if ok then atlasAsset = asset end
	return ok and asset or nil
end

---Download a remote image once and return a local asset for it.
---@param url string
---@return string?, number?, number?
local function resolveRemoteImage(url)
	if not (writefile and isfile and isfolder and makefolder and getcustomasset) then return nil end
	if not isfolder("serpent") then makefolder("serpent") end
	if not isfolder("serpent/images") then makefolder("serpent/images") end

	local path = string.format("serpent/images/%s.png", url:gsub("[^%w]", "_"):sub(-80))
	if not isfile(path) then
		local ok, data = pcall(game.HttpGet, game, url)
		if not ok then return nil end
		writefile(path, data)
	end

	local width, height
	local readOk, data = pcall(readfile, path)
	if readOk and #data >= 24 then width, height = string.unpack(">I4I4", data, 17) end

	local ok, asset = pcall(getcustomasset, path)
	if not ok then return nil end
	return asset, width, height
end

---Apply a Lucide icon name (or a raw rbxassetid) to an image object.
---@param image ImageLabel|ImageButton
---@param name string?
---@return boolean
local function setIcon(image, name)
	if type(name) ~= "string" then return false end
	if name:find("^https?://") then
		local asset = resolveRemoteImage(name)
		if not asset then return false end
		image.Image = asset
		return true
	end
	if name:find("^rbxasset") then
		image.Image = name
		return true
	end

	local rect = ATLAS_RECTS[name]
	if rect then
		local asset = getAtlas()
		if asset then
			image.Image = asset
			image.ImageRectOffset = Vector2.new(rect[1], rect[2])
			image.ImageRectSize = Vector2.new(rect[3], rect[4])
			return true
		end
	end

	local lucide = getLucide()
	if not lucide then return false end
	local asset = lucide.GetAsset(name)
	if not asset then return false end
	image.Image = asset.Url
	image.ImageRectSize = asset.ImageRectSize
	image.ImageRectOffset = asset.ImageRectOffset
	return true
end

---Run a callback now and again on every theme change.
---@param callback function
local function bindTheme(callback)
	table.insert(themeHooks, callback)
	callback()
end

---Track a connection so Unload can sever it.
---@param connection RBXScriptConnection
local function track(connection)
	table.insert(libraryConnections, connection)
	return connection
end

---Create an instance from a property table.
local function create(class, properties)
	local instance = Instance.new(class)
	for key, value in pairs(properties) do
		if key ~= "Parent" then instance[key] = value end
	end
	instance.Parent = properties.Parent
	return instance
end

local function tween(instance, info, goal)
	local t = tweenService:Create(instance, info, goal)
	t:Play()
	return t
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function lighten(color, amount)
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isInside(guiObject, position)
	local pos, size = guiObject.AbsolutePosition, guiObject.AbsoluteSize
	return position.X >= pos.X and position.X <= pos.X + size.X and position.Y >= pos.Y and position.Y <= pos.Y + size.Y
end

local function formatKeyName(key)
	if not key then return "None" end
	local name = key.Name
	if name == "MouseButton1" then return "MB1" end
	if name == "MouseButton2" then return "MB2" end
	if name == "MouseButton3" then return "MB3" end
	return name
end

---Tween a property between two theme-aware colors on hover.
local function addHover(object, normal, hovered, property)
	property = property or "BackgroundColor3"
	object.MouseEnter:Connect(function() tween(object, TWEEN_FAST, { [property] = hovered() }) end)
	object.MouseLeave:Connect(function() tween(object, TWEEN_FAST, { [property] = normal() }) end)
end

---Squash the object slightly while it is pressed.
local function addPress(object, amount)
	local scale = create("UIScale", { Parent = object })
	local function release() tween(scale, TWEEN_FAST, { Scale = 1 }) end
	object.MouseButton1Down:Connect(function() tween(scale, TWEEN_DRAG, { Scale = amount or 0.96 }) end)
	object.MouseButton1Up:Connect(release)
	object.MouseLeave:Connect(release)
	return scale
end

---Checkbox used by Toggle, Pills and Slider.
local function makeCheck(parent, initial, onChange, size)
	size = size or 14
	local state = initial and true or false
	local box = create("TextButton", { Size = UDim2.fromOffset(size, size), Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Track, Parent = parent })
	corner(box, 4)
	local stroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = box })
	local mark = create("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size - 4, size - 4), BackgroundTransparency = 1, ImageColor3 = Theme.AccentText, ImageTransparency = 1, Parent = box })
	setIcon(mark, Library.Icons.Check)
	local markScale = create("UIScale", { Parent = mark })
	local pop = create("UIScale", { Parent = box })

	local function paint(animate)
		local goal = { BackgroundColor3 = state and Theme.Accent or Theme.Track }
		local markGoal = { ImageTransparency = state and 0 or 1, ImageColor3 = Theme.AccentText }
		local strokeGoal = { Transparency = state and 1 or 0 }
		if animate then
			tween(box, TWEEN_FAST, goal)
			tween(mark, TWEEN_FAST, markGoal)
			tween(stroke, TWEEN_FAST, strokeGoal)
		else
			box.BackgroundColor3 = goal.BackgroundColor3
			mark.ImageTransparency = markGoal.ImageTransparency
			mark.ImageColor3 = markGoal.ImageColor3
			stroke.Transparency = strokeGoal.Transparency
		end
	end
	bindTheme(function() paint(false) end)

	box.MouseEnter:Connect(function()
		if not state then tween(box, TWEEN_FAST, { BackgroundColor3 = lighten(Theme.Track, 0.1) }) end
	end)
	box.MouseLeave:Connect(function()
		if not state then tween(box, TWEEN_FAST, { BackgroundColor3 = Theme.Track }) end
	end)

	local check = { Button = box }
	function check.Get() return state end
	function check.Set(value, fire)
		state = value and true or false
		paint(true)
		pop.Scale = 0.8
		tween(pop, TWEEN_POP, { Scale = 1 })
		if state then
			markScale.Scale = 0.3
			tween(markScale, TWEEN_POP, { Scale = 1 })
		end
		if fire and onChange then onChange(state) end
	end
	box.MouseButton1Click:Connect(function() check.Set(not state, true) end)
	return check
end

---Get the active theme table (mutable).
function Library:GetTheme()
	return Theme
end

---Apply theme values and repaint everything.
function Library:SetTheme(newTheme)
	for key, value in pairs(newTheme) do
		if Theme[key] ~= nil then Theme[key] = value end
	end
	for _, hook in ipairs(themeHooks) do pcall(hook) end
end

---Set the key that toggles every window.
function Library:SetWindowKeybind(key)
	self.ToggleKey = key
end

---Serialize every flag (except Config_ ones) to JSON.
function Library:SerializeFlags()
	local data = {}
	for flag, component in pairs(self.Flags) do
		if flag:find("^Config_") then continue end
		local kind = component:GetComponentType()
		local value = component.GetValue and component:GetValue()
		if kind == "Keybind" then
			if value then data[flag] = { "Keybind", value.Name, value.EnumType == Enum.KeyCode } end
		elseif kind == "Colorpicker" then
			data[flag] = { "Colorpicker", { value.R, value.G, value.B }, component:GetTransparency() }
		elseif kind ~= "Button" then
			data[flag] = { kind, value }
		end
	end
	return httpService:JSONEncode(data)
end

---Restore flags from JSON made by SerializeFlags.
function Library:LoadFlags(content)
	local ok, data = pcall(httpService.JSONDecode, httpService, content)
	if not ok then return false end
	for flag, entry in pairs(data) do
		local component = self.Flags[flag]
		if not component or entry[1] ~= component:GetComponentType() then continue end
		pcall(function()
			if entry[1] == "Keybind" then
				component:SetValue(entry[3] and Enum.KeyCode[entry[2]] or Enum.UserInputType[entry[2]])
			elseif entry[1] == "Colorpicker" then
				component:SetValue(Color3.new(unpack(entry[2])))
				component:SetTransparency(entry[3])
			else
				component:SetValue(entry[2])
			end
		end)
	end
	return true
end

---Destroy every window and disconnect every listener.
function Library:Unload()
	for _, window in ipairs(self.Windows) do window.ScreenGui:Destroy() end
	for _, connection in ipairs(libraryConnections) do connection:Disconnect() end
	table.clear(self.Windows)
	table.clear(libraryConnections)
	table.clear(themeHooks)
	table.clear(self.Flags)
end

---Dropdown shared by Tab:Dropdown and the body selector.
local function buildDropdown(Window, parent, opts, compact)
	local list = opts.Options or {}
	local multi = opts.Multi or false
	local placeholder = opts.Title or "Select"
	local callback = opts.Callback or function() end
	local selected = {}

	local default = opts.Default
	if multi then
		if type(default) == "table" then for _, v in ipairs(default) do table.insert(selected, v) end end
	elseif type(default) == "string" and default ~= "" then
		table.insert(selected, default)
	elseif type(default) == "table" and #default > 0 then
		table.insert(selected, default[1])
	end

	local height = compact and 24 or 32
	local itemHeight = compact and 26 or 28
	local textSize = compact and 12 or 13
	local maxMenuHeight = 5 * (itemHeight + 2) + 6

	local button = create("TextButton", { Size = opts.Width and UDim2.fromOffset(opts.Width, height) or UDim2.new(1, 0, 0, height), BackgroundColor3 = Theme.Surface, Text = "", AutoButtonColor = false, Parent = parent })
	corner(button, compact and 6 or 8)
	local buttonStroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Transparency = 1, Parent = button })
	addPress(button, 0.985)
	local label = create("TextLabel", { Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(compact and 9 or 12, 0), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = textSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = button })
	local chevron = create("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(compact and 12 or 14, compact and 12 or 14), Position = UDim2.new(1, compact and -13 or -15, 0.5, 0), BackgroundTransparency = 1, ImageColor3 = Theme.TextPrimary, Parent = button })
	setIcon(chevron, Library.Icons.Chevron)
	addHover(button, function() return Theme.Surface end, function() return lighten(Theme.Surface, 0.05) end)

	-- Menu fades as a whole through a CanvasGroup; the list slides in underneath it.
	local menu = create("CanvasGroup", { Size = UDim2.fromOffset(120, 0), BackgroundColor3 = Theme.Surface, GroupTransparency = 1, Visible = false, ZIndex = 4000, BorderSizePixel = 0, Parent = Window.ScreenGui })
	corner(menu, 8)
	local menuStroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = menu })
	local scroller = create("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Track, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 4000, Parent = menu })
	create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = scroller })
	local menuLayout = create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = scroller })

	local items, open, follow, flipUp = {}, false, nil, false

	local function updateText()
		local text = table.concat(selected, ", ")
		label.Text = text == "" and placeholder or text
		label.TextColor3 = text == "" and Theme.TextSecondary or Theme.TextPrimary
	end
	local function menuHeight() return math.min(menuLayout.AbsoluteContentSize.Y + 8, maxMenuHeight) end
	local function isOn(option) return table.find(selected, option) ~= nil end
	local function restingTransparency(option) return isOn(option) and 0.72 or 1 end

	local function paintOptions(animate)
		for option, parts in pairs(items) do
			local on = isOn(option)
			local goals = {
				{ parts.Label, { TextColor3 = on and Theme.TextPrimary or Theme.TextSecondary } },
				{ parts.Check, { ImageTransparency = on and 0 or 1, ImageColor3 = Theme.Accent } },
				{ parts.Item, { BackgroundTransparency = restingTransparency(option), BackgroundColor3 = Theme.Track } },
			}
			for _, pair in ipairs(goals) do
				if animate then
					tween(pair[1], TWEEN_FAST, pair[2])
				else
					for key, value in pairs(pair[2]) do pair[1][key] = value end
				end
			end
		end
	end

	local function place()
		local pos, size = button.AbsolutePosition, button.AbsoluteSize
		menu.AnchorPoint = Vector2.new(0, flipUp and 1 or 0)
		menu.Position = UDim2.fromOffset(pos.X, flipUp and pos.Y - 4 or pos.Y + size.Y + 4)
	end

	local popup = {}
	function popup.IsOpen() return open end
	function popup.Contains(position) return isInside(menu, position) or isInside(button, position) end
	function popup.Close()
		if not open then return end
		open = false
		tween(chevron, TWEEN_OPEN, { Rotation = 0 })
		tween(buttonStroke, TWEEN_FAST, { Transparency = 1 })
		tween(scroller, TWEEN_CLOSE, { Position = UDim2.fromOffset(0, flipUp and 6 or -6) })
		local t = tween(menu, TWEEN_CLOSE, { Size = UDim2.fromOffset(menu.Size.X.Offset, 0), GroupTransparency = 1 })
		t.Completed:Once(function()
			if not open then
				menu.Visible = false
				if follow then follow:Disconnect() follow = nil end
			end
		end)
	end
	table.insert(Window.Popups, popup)

	local api = { Button = button }

	local function setValue(value, fire)
		selected = {}
		if multi then
			if type(value) == "table" then for _, v in ipairs(value) do table.insert(selected, v) end end
		elseif type(value) == "string" and value ~= "" then
			table.insert(selected, value)
		elseif type(value) == "table" and #value > 0 then
			table.insert(selected, value[1])
		end
		paintOptions(true)
		updateText()
		if fire then callback(multi and selected or selected[1]) end
	end

	local function setOptions(newList)
		list = type(newList) == "table" and newList or {}
		for _, parts in pairs(items) do parts.Item:Destroy() end
		table.clear(items)
		local kept = {}
		for _, item in ipairs(selected) do
			if table.find(list, item) then table.insert(kept, item) end
		end
		selected = kept
		for index, option in ipairs(list) do
			local item = create("TextButton", { Size = UDim2.new(1, 0, 0, itemHeight), BackgroundColor3 = Theme.Track, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = index, ZIndex = 4001, Parent = scroller })
			corner(item, 6)
			local itemLabel = create("TextLabel", { Size = UDim2.new(1, -32, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = option, TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = textSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4002, Parent = item })
			local itemCheck = create("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), Position = UDim2.new(1, -14, 0.5, 0), BackgroundTransparency = 1, ImageColor3 = Theme.Accent, ImageTransparency = 1, ZIndex = 4002, Parent = item })
			setIcon(itemCheck, Library.Icons.Check)
			items[option] = { Item = item, Label = itemLabel, Check = itemCheck }

			item.MouseEnter:Connect(function()
				tween(item, TWEEN_FAST, { BackgroundTransparency = isOn(option) and 0.5 or 0.78 })
				tween(itemLabel, TWEEN_FAST, { TextColor3 = Theme.TextPrimary })
			end)
			item.MouseLeave:Connect(function()
				tween(item, TWEEN_FAST, { BackgroundTransparency = restingTransparency(option) })
				tween(itemLabel, TWEEN_FAST, { TextColor3 = isOn(option) and Theme.TextPrimary or Theme.TextSecondary })
			end)
			item.MouseButton1Click:Connect(function()
				if multi then
					local copy = table.clone(selected)
					local at = table.find(copy, option)
					if at then table.remove(copy, at) else table.insert(copy, option) end
					setValue(copy, true)
				else
					setValue(option, true)
					popup.Close()
				end
			end)
		end
		paintOptions(false)
		updateText()
		if open then tween(menu, TWEEN_SMOOTH, { Size = UDim2.fromOffset(menu.Size.X.Offset, menuHeight()) }) end
	end
	setOptions(list)

	bindTheme(function()
		button.BackgroundColor3 = Theme.Surface
		buttonStroke.Color = Theme.TextSecondary
		chevron.ImageColor3 = Theme.TextPrimary
		menu.BackgroundColor3 = Theme.Surface
		menuStroke.Color = Theme.Border
		scroller.ScrollBarImageColor3 = Theme.Track
		updateText()
		paintOptions(false)
	end)

	button.MouseButton1Click:Connect(function()
		if open then return popup.Close() end
		Window:ClosePopups(popup)
		open = true

		local screenHeight = Window.ScreenGui.AbsoluteSize.Y
		local fullHeight = menuHeight()
		flipUp = button.AbsolutePosition.Y + button.AbsoluteSize.Y + 4 + fullHeight > screenHeight - 8

		menu.Visible = true
		menu.GroupTransparency = 1
		menu.Size = UDim2.fromOffset(math.max(button.AbsoluteSize.X, compact and 96 or 110), 0)
		scroller.Position = UDim2.fromOffset(0, flipUp and 8 or -8)
		place()

		tween(chevron, TWEEN_OPEN, { Rotation = 180 })
		tween(buttonStroke, TWEEN_FAST, { Transparency = 0 })
		tween(menu, TWEEN_OPEN, { Size = UDim2.fromOffset(menu.Size.X.Offset, fullHeight), GroupTransparency = 0 })
		tween(scroller, TWEEN_OPEN, { Position = UDim2.fromOffset(0, 0) })

		-- Stagger the option labels in.
		for index, option in ipairs(list) do
			local parts = items[option]
			parts.Label.TextTransparency = 1
			task.delay((index - 1) * 0.03, function()
				if parts.Label.Parent and open then tween(parts.Label, TWEEN_OPEN, { TextTransparency = 0 }) end
			end)
		end

		if follow then follow:Disconnect() end
		follow = runService.RenderStepped:Connect(place)
	end)

	function api:GetComponentType() return "Dropdown" end
	function api:GetValue() return multi and selected or selected[1] end
	function api:SetValue(value) setValue(value, true) end
	function api:SetOptions(newList) setOptions(newList) end
	function api:GetOptions() return list end
	return api
end

---Create a window.
---@param options table {Title, Suffix, SubTitle, Logo, Size}
function Library:Window(options)
	options = options or {}
	local size = options.Size or Vector2.new(604, 386)

	local screenGui = create("ScreenGui", { Name = "Serpent", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
	local parented = pcall(function() screenGui.Parent = (gethui and gethui()) or coreGui end)
	if not parented then screenGui.Parent = localPlayer:WaitForChild("PlayerGui") end

	-- Root carries position and scale so the CanvasGroup can fade on its own.
	local root = create("Frame", { Size = UDim2.fromOffset(size.X, size.Y), Position = UDim2.new(0.5, -size.X / 2, 0.5, -size.Y / 2), BackgroundTransparency = 1, Parent = screenGui })
	local rootScale = create("UIScale", { Scale = 0.92, Parent = root })

	local mainFrame = create("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Body, BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 1, Parent = root })
	corner(mainFrame, 12)
	local frameStroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Transparency = 0.5, Parent = mainFrame })

	local sidebar = create("Frame", { Size = UDim2.new(0, SIDEBAR_WIDTH, 1, 0), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Active = true, Parent = mainFrame })
	local dragStrip = create("Frame", { Size = UDim2.new(1, -SIDEBAR_WIDTH, 0, 20), Position = UDim2.fromOffset(SIDEBAR_WIDTH, 0), BackgroundTransparency = 1, Active = true, Parent = mainFrame })

	-- Logo row: 16px from the left, centered at y = 27.
	local logoHolder = create("Frame", { Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(16, 17), BackgroundTransparency = 1, Parent = sidebar })
	local logoOffset = 0
	local logoIcon
	local logoOnly = options.Logo and (options.Title == nil or options.Title == "")
	local LOGO_MAX_W, LOGO_MAX_H = 124, 36
	if options.Logo then
		-- Logo-only mode lets the image replace the title text and fill the title area.
		logoIcon = create("ImageLabel", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = logoOnly and UDim2.fromOffset(LOGO_MAX_W, LOGO_MAX_H) or UDim2.fromOffset(20, 20), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, ImageColor3 = Color3.new(1, 1, 1), Parent = logoHolder })
		task.spawn(function()
			local isUrl = options.Logo:find("^https?://")
			if isUrl then
				local asset, width, height = resolveRemoteImage(options.Logo)
				if not asset then return end
				logoIcon.Image = asset
				if logoOnly and width and height and width > 0 and height > 0 then
					local scale = math.min(LOGO_MAX_W / width, LOGO_MAX_H / height)
					logoIcon.Size = UDim2.fromOffset(math.floor(width * scale), math.floor(height * scale))
				end
			else
				setIcon(logoIcon, options.Logo)
			end
		end)
		logoOffset = logoOnly and 0 or 26
	end
	local logoLabel = create("TextLabel", { Size = UDim2.new(1, -logoOffset, 1, 0), Position = UDim2.fromOffset(logoOffset, 0), BackgroundTransparency = 1, RichText = true, Text = "", Visible = not logoOnly, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Parent = logoHolder })

	-- Navigation: a sliding white pill sits under the item list.
	local navHolder = create("Frame", { Size = UDim2.new(0, 124, 1, -110), Position = UDim2.fromOffset(10, 62), BackgroundTransparency = 1, Parent = sidebar })
	local navPill = create("Frame", { Size = UDim2.new(1, 0, 0, NAV_ITEM_HEIGHT), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1, Parent = navHolder })
	corner(navPill, 8)
	local navItems = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2, Parent = navHolder })
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, NAV_ITEM_GAP), Parent = navItems })

	local versionLabel = create("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -34), BackgroundTransparency = 1, Text = options.SubTitle or "Version 1.0", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 12, Parent = sidebar })

	local contentArea = create("Frame", { Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, 0), Position = UDim2.fromOffset(SIDEBAR_WIDTH, 0), BackgroundTransparency = 1, Parent = mainFrame })

	local closeBtn = create("ImageButton", { Size = UDim2.fromOffset(12, 12), Position = UDim2.new(1, -17, 0, 19), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ImageColor3 = Theme.TextSecondary, ZIndex = 20, Parent = mainFrame })
	setIcon(closeBtn, Library.Icons.Close)
	closeBtn.MouseEnter:Connect(function() tween(closeBtn, TWEEN_FAST, { ImageColor3 = Theme.TextPrimary }) end)
	closeBtn.MouseLeave:Connect(function() tween(closeBtn, TWEEN_FAST, { ImageColor3 = Theme.TextSecondary }) end)
	addPress(closeBtn, 0.85)

	local notifyHolder = create("Frame", { Size = UDim2.new(0, 280, 1, -20), Position = UDim2.new(1, -10, 0, 10), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 6000, Parent = screenGui })
	create("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = notifyHolder })

	bindTheme(function()
		mainFrame.BackgroundColor3 = Theme.Body
		frameStroke.Color = Theme.Border
		sidebar.BackgroundColor3 = Theme.Sidebar
		logoLabel.TextColor3 = Theme.TextPrimary
		logoLabel.Text = string.format('<b>%s</b> <font color="#%s">%s</font>', options.Title or "Serpent", Theme.NavText:ToHex(), options.Suffix or "")
		navPill.BackgroundColor3 = Theme.Accent
		versionLabel.TextColor3 = Theme.TextSecondary
		closeBtn.ImageColor3 = Theme.TextSecondary
	end)

	local Window = { ScreenGui = screenGui, Scale = rootScale, Tabs = {}, CurrentTab = nil, Popups = {}, Visible = true, _notifyOrder = 0 }
	table.insert(Library.Windows, Window)

	-- Intro animation.
	task.defer(function()
		tween(rootScale, TWEEN_POP, { Scale = 1 })
		tween(mainFrame, TWEEN_SLOW, { GroupTransparency = 0 })
	end)

	local function makeDraggable(handle)
		handle.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			local startInput, startPos = input.Position, root.Position
			local moveConn, endConn
			moveConn = userInputService.InputChanged:Connect(function(move)
				if move.UserInputType == Enum.UserInputType.MouseMovement or move.UserInputType == Enum.UserInputType.Touch then
					local delta = move.Position - startInput
					root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
					Window:ClosePopups()
				end
			end)
			endConn = userInputService.InputEnded:Connect(function(finish)
				if isPress(finish) then moveConn:Disconnect() endConn:Disconnect() end
			end)
		end)
	end
	makeDraggable(sidebar)
	makeDraggable(dragStrip)

	---Close every open popup.
	function Window:ClosePopups(except)
		for _, popup in ipairs(self.Popups) do
			if popup ~= except and popup.IsOpen() then popup.Close() end
		end
	end

	---Show or hide the window with a scale and fade animation.
	function Window:ToggleVisibility()
		self.Visible = not self.Visible
		if self.Visible then
			root.Visible = true
			tween(rootScale, TWEEN_POP, { Scale = 1 })
			tween(mainFrame, TWEEN_SMOOTH, { GroupTransparency = 0 })
		else
			self:ClosePopups()
			tween(rootScale, TWEEN_SMOOTH, { Scale = 0.94 })
			local t = tween(mainFrame, TWEEN_SMOOTH, { GroupTransparency = 1 })
			t.Completed:Once(function()
				if not self.Visible then root.Visible = false end
			end)
		end
	end
	closeBtn.MouseButton1Click:Connect(function() Window:ToggleVisibility() end)

	---Destroy this window.
	function Window:Destroy()
		screenGui:Destroy()
		local index = table.find(Library.Windows, self)
		if index then table.remove(Library.Windows, index) end
	end

	---Slide-in toast with a countdown bar.
	function Window:Notify(opts)
		opts = opts or {}
		local duration = opts.Duration or 4
		self._notifyOrder += 1
		local wrap = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = self._notifyOrder, ZIndex = 6001, Parent = notifyHolder })
		local card = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.fromOffset(320, 0), BackgroundColor3 = Theme.Sidebar, ClipsDescendants = true, ZIndex = 6001, Parent = wrap })
		corner(card, 8)
		create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = card })
		create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = card })
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3), Parent = card })
		create("TextLabel", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Text = opts.Title or "Notification", TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, ZIndex = 6002, Parent = card })
		create("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = opts.Content or "", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = 2, ZIndex = 6002, Parent = card })
		local bar = create("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, LayoutOrder = 3, ZIndex = 6002, Parent = card })
		corner(bar, 1)
		tween(card, TWEEN_POP, { Position = UDim2.fromOffset(0, 0) })
		tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })
		task.delay(duration, function()
			if not wrap.Parent then return end
			local t = tween(card, TWEEN_SMOOTH, { Position = UDim2.fromOffset(330, 0) })
			t.Completed:Once(function() wrap:Destroy() end)
		end)
	end

	---Create a small pinned watermark.
	function Window:Watermark(initialText)
		local frame = create("Frame", { BackgroundColor3 = Theme.Sidebar, Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 5000, Position = UDim2.fromOffset(15, 15), Parent = screenGui })
		corner(frame, 6)
		create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = frame })
		local label = create("TextLabel", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = initialText or "", RichText = true, TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = 13, ZIndex = 5001, Parent = frame })
		create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = label })
		local watermark = {}
		function watermark:SetText(text) label.Text = text end
		function watermark:SetVisible(state) frame.Visible = state end
		function watermark:SetPosition(pos)
			local right, bottom = pos:find("Right") ~= nil, pos:find("Bottom") ~= nil
			frame.AnchorPoint = Vector2.new(right and 1 or 0, bottom and 1 or 0)
			frame.Position = UDim2.new(right and 1 or 0, right and -15 or 15, bottom and 1 or 0, bottom and -15 or 15)
		end
		return watermark
	end

	track(userInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Library.ToggleKey then Window:ToggleVisibility() end
	end))

	-- One outside-click handler for every popup.
	track(userInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		for _, popup in ipairs(Window.Popups) do
			if popup.IsOpen() and not popup.Contains(position) then popup.Close() end
		end
	end))

	---Create a tab (sidebar item + page).
	---@param options table {Title, Icon (Lucide name), Padding}
	function Window:Tab(tabOptions)
		tabOptions = tabOptions or {}
		local tabTitle = tabOptions.Title or "Tab"
		local pagePadding = tabOptions.Padding or 14
		local index = #self.Tabs + 1

		local navBtn = create("TextButton", { Size = UDim2.new(1, 0, 0, NAV_ITEM_HEIGHT), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = index, Parent = navItems })
		addPress(navBtn, 0.97)
		local navIcon = create("ImageLabel", { Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 9, 0.5, -8), BackgroundTransparency = 1, ImageColor3 = Theme.NavText, Parent = navBtn })
		setIcon(navIcon, tabOptions.Icon or "circle")
		local navLabel = create("TextLabel", { Size = UDim2.new(1, -31, 1, 0), Position = UDim2.fromOffset(31, 0), BackgroundTransparency = 1, Text = tabTitle, TextColor3 = Theme.NavText, Font = Theme.Font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = navBtn })

		local group = create("CanvasGroup", { Size = UDim2.new(1, -43, 1, -43), Position = PAGE_POSITION, BackgroundTransparency = 1, GroupTransparency = 1, Visible = false, Parent = contentArea })
		local page = create("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Track, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = group })
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, pagePadding), Parent = page })

		local Tab = { Title = tabTitle, Page = page, Group = group }
		table.insert(self.Tabs, Tab)

		local function paint(animate)
			local active = Window.CurrentTab == Tab
			local fg = active and Theme.AccentText or Theme.NavText
			if animate then
				tween(navIcon, TWEEN_FAST, { ImageColor3 = fg })
				tween(navLabel, TWEEN_FAST, { TextColor3 = fg })
			else
				navIcon.ImageColor3 = fg
				navLabel.TextColor3 = fg
			end
		end
		bindTheme(function() paint(false) end)
		Tab.Repaint = paint

		navBtn.MouseEnter:Connect(function()
			if Window.CurrentTab ~= Tab then
				tween(navLabel, TWEEN_FAST, { TextColor3 = Theme.TextPrimary })
				tween(navIcon, TWEEN_FAST, { ImageColor3 = Theme.TextPrimary })
			end
		end)
		navBtn.MouseLeave:Connect(function()
			if Window.CurrentTab ~= Tab then paint(true) end
		end)

		---Switch to this tab.
		function Tab:Activate()
			local old = Window.CurrentTab
			if old == Tab then return end
			Window:ClosePopups()
			Window.CurrentTab = Tab

			local target = UDim2.fromOffset(0, (index - 1) * (NAV_ITEM_HEIGHT + NAV_ITEM_GAP))
			if old then
				tween(navPill, TWEEN_SMOOTH, { Position = target })
				tween(old.Group, TWEEN_FAST, { GroupTransparency = 1, Position = PAGE_POSITION - UDim2.fromOffset(0, 8) })
				task.delay(0.16, function()
					if Window.CurrentTab ~= old then old.Group.Visible = false end
				end)
				old.Repaint(true)
			else
				navPill.Position = target
				tween(navPill, TWEEN_SMOOTH, { BackgroundTransparency = 0 })
			end

			group.Position = PAGE_POSITION + UDim2.fromOffset(0, 12)
			group.GroupTransparency = 1
			group.Visible = true
			tween(group, TWEEN_SMOOTH, { GroupTransparency = 0, Position = PAGE_POSITION })
			paint(true)
		end
		navBtn.MouseButton1Click:Connect(function() Tab:Activate() end)
		if not Window.CurrentTab then Tab:Activate() end

		---Attach every component method to a holder (tab or split column).
		local function attach(H, container, pad)
			H.Container = container
			H._order = 0
			H._pad = pad

			local function newRow(height)
				H._order += 1
				return create("Frame", { Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, LayoutOrder = H._order, Parent = container })
			end
			local function rowTitle(row, text, reserve)
				local label = create("TextLabel", { Size = UDim2.new(1, -(reserve or 120), 1, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
				bindTheme(function() label.TextColor3 = Theme.TextPrimary end)
				return label
			end
			local function register(flag, object)
				Library.Flags[flag] = object
				return object
			end
			local function flagName(opts, kind, title)
				return opts.Flag or string.format("%s/%s/%s", tabTitle, kind, title)
			end

			local function attachColorPicker(targetRow, compTitle, props, rightOffset)
				props = props or {}
				local currentColor = props.Default or Color3.new(1, 1, 1)
				local currentAlpha = (props.Transparency or 100) / 100
				local hue, sat, val = currentColor:ToHSV()
				local callback = props.Callback or function() end

				local holder = create("Frame", { Size = UDim2.new(0, 160, 1, 0), Position = UDim2.new(1, -(rightOffset or 0), 0, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 10, Parent = targetRow })
				create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), Parent = holder })
				local colorBtn = create("TextButton", { Size = UDim2.fromOffset(20, 20), BackgroundColor3 = currentColor, Text = "", AutoButtonColor = false, LayoutOrder = 1, ZIndex = 10, Parent = holder })
				corner(colorBtn, 5)
				create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = colorBtn })
				addPress(colorBtn, 0.9)
				local hexBox = create("TextBox", { Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 12, ClearTextOnFocus = false, LayoutOrder = 0, ZIndex = 10, Parent = holder })

				local picker = create("CanvasGroup", { BackgroundColor3 = Theme.Surface, BorderSizePixel = 0, Size = UDim2.fromOffset(220, 205), GroupTransparency = 1, Visible = false, ZIndex = 3000, Parent = screenGui })
				corner(picker, 8)
				local pickerStroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = picker })
				create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), Parent = picker })
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = picker })

				local colorMap = create("TextButton", { Size = UDim2.new(1, 0, 0, 120), BackgroundColor3 = Color3.fromHSV(hue, 1, 1), AutoButtonColor = false, Text = "", LayoutOrder = 1, ZIndex = 3001, Parent = picker })
				corner(colorMap, 5)
				local satOverlay = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3002, Parent = colorMap })
				create("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = satOverlay })
				corner(satOverlay, 5)
				local valOverlay = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 3003, Parent = colorMap })
				create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Parent = valOverlay })
				corner(valOverlay, 5)
				local marker = create("Frame", { Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(sat, 1 - val), ZIndex = 3004, Parent = colorMap })
				corner(marker, 6)
				create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = marker })

				local function makeBar(name, order)
					local frame = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order, ZIndex = 3001, Parent = picker })
					create("TextLabel", { Text = name, Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Font = Theme.Font, TextSize = 11, TextColor3 = Theme.TextSecondary, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3001, Parent = frame })
					local barTrack = create("TextButton", { BackgroundColor3 = Theme.Track, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 3), Text = "", AutoButtonColor = false, ZIndex = 3001, Parent = frame })
					corner(barTrack, 2)
					local barFill = create("Frame", { BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, ZIndex = 3002, Parent = barTrack })
					corner(barFill, 2)
					return { Track = barTrack, Fill = barFill }
				end
				local hueBar, alphaBar = makeBar("Hue", 2), makeBar("Transparency", 3)

				bindTheme(function()
					hexBox.TextColor3 = Theme.TextSecondary
					picker.BackgroundColor3 = Theme.Surface
					pickerStroke.Color = Theme.Border
					for _, bar in ipairs({ hueBar, alphaBar }) do
						bar.Track.BackgroundColor3 = Theme.Track
						bar.Fill.BackgroundColor3 = Theme.Accent
					end
				end)

				local function refresh(fire)
					tween(colorBtn, TWEEN_DRAG, { BackgroundColor3 = currentColor })
					hexBox.Text = "#" .. currentColor:ToHex():upper()
					colorMap.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
					tween(marker, TWEEN_DRAG, { Position = UDim2.fromScale(sat, 1 - val) })
					tween(hueBar.Fill, TWEEN_DRAG, { Size = UDim2.fromScale(hue, 1) })
					tween(alphaBar.Fill, TWEEN_DRAG, { Size = UDim2.fromScale(currentAlpha, 1) })
					if fire then callback(currentColor, currentAlpha * 100) end
				end

				hexBox.FocusLost:Connect(function()
					local ok, parsed = pcall(Color3.fromHex, hexBox.Text)
					if ok then
						currentColor = parsed
						hue, sat, val = parsed:ToHSV()
						refresh(true)
					else
						hexBox.Text = "#" .. currentColor:ToHex():upper()
					end
				end)

				local function drag(guiObject, kind, input)
					local function update(position)
						local x = math.clamp((position.X - guiObject.AbsolutePosition.X) / guiObject.AbsoluteSize.X, 0, 1)
						local y = math.clamp((position.Y - guiObject.AbsolutePosition.Y) / guiObject.AbsoluteSize.Y, 0, 1)
						if kind == "Map" then sat, val = x, 1 - y
						elseif kind == "Hue" then hue = x
						else currentAlpha = x end
						currentColor = Color3.fromHSV(hue, sat, val)
						refresh(true)
					end
					update(input.Position)
					local moveConn, endConn
					moveConn = userInputService.InputChanged:Connect(function(move)
						if move.UserInputType == Enum.UserInputType.MouseMovement or move.UserInputType == Enum.UserInputType.Touch then update(move.Position) end
					end)
					endConn = userInputService.InputEnded:Connect(function(finish)
						if isPress(finish) then moveConn:Disconnect() endConn:Disconnect() end
					end)
				end
				colorMap.InputBegan:Connect(function(i) if isPress(i) then drag(colorMap, "Map", i) end end)
				hueBar.Track.InputBegan:Connect(function(i) if isPress(i) then drag(hueBar.Track, "Hue", i) end end)
				alphaBar.Track.InputBegan:Connect(function(i) if isPress(i) then drag(alphaBar.Track, "Alpha", i) end end)

				local open = false
				local popup = {}
				function popup.IsOpen() return open end
				function popup.Contains(position) return isInside(picker, position) or isInside(colorBtn, position) end
				function popup.Close()
					if not open then return end
					open = false
					tween(picker, TWEEN_CLOSE, { GroupTransparency = 1 })
					local t = tween(picker, TWEEN_CLOSE, { Size = UDim2.fromOffset(220, 195) })
					t.Completed:Once(function() if not open then picker.Visible = false end end)
				end
				table.insert(Window.Popups, popup)

				colorBtn.MouseButton1Click:Connect(function()
					if open then return popup.Close() end
					Window:ClosePopups(popup)
					local btnPos, screenSize = colorBtn.AbsolutePosition, screenGui.AbsoluteSize
					local x, y = btnPos.X - 230, btnPos.Y + 26
					if x < 0 then x = btnPos.X + 30 end
					if y + 215 > screenSize.Y then y = screenSize.Y - 220 end
					picker.Position = UDim2.fromOffset(x, y + 8)
					picker.Size = UDim2.fromOffset(220, 195)
					picker.GroupTransparency = 1
					picker.Visible = true
					open = true
					tween(picker, TWEEN_OPEN, { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(220, 205), GroupTransparency = 0 })
				end)
				refresh(false)

				local object = {}
				function object:GetComponentType() return "Colorpicker" end
				function object:GetValue() return currentColor end
				function object:GetTransparency() return currentAlpha * 100 end
				function object:SetValue(color) currentColor = color hue, sat, val = color:ToHSV() refresh(true) end
				function object:SetTransparency(alpha) currentAlpha = math.clamp(alpha, 0, 100) / 100 refresh(true) end
				return register(props.Flag or string.format("%s/Colorpicker/%s", tabTitle, compTitle), object)
