-- API: Library:Window{SubTitle} -> Window:Tab / Watermark / Notify / SetupConfig / Unload
-- Tab components: Toggle (+:Colorpicker), Slider (Dual), Dropdown (Multi), Keybind, Textbox, Button, Colorpicker, Label, Section

-- Services.
local playersService = game:GetService("Players")
local userInputService = game:GetService("UserInputService")
