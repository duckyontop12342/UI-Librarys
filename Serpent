}

local Library = {
	ToggleKey = Enum.KeyCode.RightShift,
	Flags = {},
	Windows = {},
}

local themeHooks = {}
local libraryConnections = {}

---Run a callback now and again on every theme change.
---@param callback function
local function bindTheme(callback)
	table.insert(themeHooks, callback)
	callback()
end

---Track a connection so Unload can sever it.
---@param connection RBXScriptConnection
local function track(connection)
	table.insert(libraryConnections, connection)
	return connection
end

---Create an instance from a property table.
---@param class string
---@param properties table
local function create(class, properties)
	local instance = Instance.new(class)
	for key, value in pairs(properties) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	instance.Parent = properties.Parent
	return instance
end

local function tween(instance, info, goal)
	local t = tweenService:Create(instance, info, goal)
	t:Play()
	return t
end

local function formatKeyName(key)
	if not key then return "None" end
	local name = key.Name
	if name == "MouseButton1" then return "MB1" end
	if name == "MouseButton2" then return "MB2" end
	if name == "MouseButton3" then return "MB3" end
	return name
end

local function isInside(guiObject, position)
	local pos, size = guiObject.AbsolutePosition, guiObject.AbsoluteSize
	return position.X >= pos.X and position.X <= pos.X + size.X and position.Y >= pos.Y and position.Y <= pos.Y + size.Y
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

---Get the active theme table (mutable).
function Library:GetTheme()
	return Theme
end

---Apply theme values and repaint everything.
---@param newTheme table
function Library:SetTheme(newTheme)
	for key, value in pairs(newTheme) do
		if Theme[key] ~= nil then
			Theme[key] = value
		end
	end
	for _, hook in ipairs(themeHooks) do
		pcall(hook)
	end
end

---Set the key that toggles every window.
function Library:SetWindowKeybind(key)
	self.ToggleKey = key
end

---Serialize every flag (except ones prefixed Config_) to a JSON string.
function Library:SerializeFlags()
	local data = {}
	for flag, component in pairs(self.Flags) do
		if flag:find("^Config_") then continue end
		local kind = component:GetComponentType()
		local value = component.GetValue and component:GetValue()
		if kind == "Keybind" then
			if value then
				data[flag] = { "Keybind", value.Name, value.EnumType == Enum.KeyCode }
			end
		elseif kind == "Colorpicker" then
			data[flag] = { "Colorpicker", { value.R, value.G, value.B }, component:GetTransparency() }
		elseif kind == "Toggle" or kind == "Slider" or kind == "Dropdown" or kind == "Textbox" then
			data[flag] = { kind, value }
		end
	end
	return httpService:JSONEncode(data)
end

---Restore flags from a JSON string made by SerializeFlags.
---@param content string
function Library:LoadFlags(content)
	local ok, data = pcall(httpService.JSONDecode, httpService, content)
	if not ok then return false end
	for flag, entry in pairs(data) do
		local component = self.Flags[flag]
		if not component or entry[1] ~= component:GetComponentType() then continue end
		pcall(function()
			if entry[1] == "Keybind" then
				component:SetValue(entry[3] and Enum.KeyCode[entry[2]] or Enum.UserInputType[entry[2]])
			elseif entry[1] == "Colorpicker" then
				component:SetValue(Color3.new(unpack(entry[2])))
				component:SetTransparency(entry[3])
			else
				component:SetValue(entry[2])
			end
		end)
	end
	return true
end

---Destroy every window and disconnect every listener.
function Library:Unload()
	for _, window in ipairs(self.Windows) do
		window.ScreenGui:Destroy()
	end
	for _, connection in ipairs(libraryConnections) do
		connection:Disconnect()
	end
	table.clear(self.Windows)
	table.clear(libraryConnections)
	table.clear(themeHooks)
	table.clear(self.Flags)
end

---Create a window.
---@param options table {SubTitle, Size}
function Library:Window(options)
	options = options or {}
	local subTitle = options.SubTitle or "v1.0.0"
	local size = options.Size or Vector2.new(850, 550)

	local screenGui = create("ScreenGui", { Name = "Serpent", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
	local parented = pcall(function()
		screenGui.Parent = (gethui and gethui()) or coreGui
	end)
	if not parented then
		screenGui.Parent = localPlayer:WaitForChild("PlayerGui")
	end

	local mainFrame = create("CanvasGroup", { Size = UDim2.fromOffset(size.X, size.Y), Position = UDim2.new(0.5, -size.X / 2, 0.5, -size.Y / 2), BackgroundColor3 = Theme.Body, BorderSizePixel = 0, Parent = screenGui })
	create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = mainFrame })
	create("UIDragDetector", { Parent = mainFrame })

	local bottomBar = create("Frame", { Size = UDim2.new(1, 0, 0, 64), Position = UDim2.new(0, 0, 1, -64), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Parent = mainFrame })

	local profileFrame = create("Frame", { Size = UDim2.new(0, 200, 1, 0), Position = UDim2.new(0, 20, 0, 0), BackgroundTransparency = 1, Parent = bottomBar })
	local avatarImage = create("ImageLabel", { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0, 0, 0.5, -20), BackgroundColor3 = Theme.Search, Parent = profileFrame })
	create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = avatarImage })
	task.spawn(function()
		local ok, thumb = pcall(playersService.GetUserThumbnailAsync, playersService, localPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		if ok then avatarImage.Image = thumb end
	end)
	local profileName = create("TextLabel", { Size = UDim2.new(1, -52, 0, 20), Position = UDim2.new(0, 52, 0.5, -18), BackgroundTransparency = 1, Text = localPlayer.DisplayName, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = profileFrame })
	local profileSub = create("TextLabel", { Size = UDim2.new(1, -52, 0, 16), Position = UDim2.new(0, 52, 0.5, 2), BackgroundTransparency = 1, Text = subTitle, TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = profileFrame })

	local tabNav = create("Frame", { Size = UDim2.new(0, 300, 1, 0), Position = UDim2.new(0.5, -150, 0, 0), BackgroundTransparency = 1, Parent = bottomBar })
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 12), Parent = tabNav })

	local actionContainer = create("Frame", { Size = UDim2.new(0, 250, 1, 0), Position = UDim2.new(1, -270, 0, 0), BackgroundTransparency = 1, Parent = bottomBar })
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 12), Parent = actionContainer })

	local saveBtn = create("TextButton", { Size = UDim2.fromOffset(40, 40), BackgroundColor3 = Theme.Search, Text = "", AutoButtonColor = false, LayoutOrder = 2, Parent = actionContainer })
	create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = saveBtn })
	local saveIcon = create("ImageLabel", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Image = ICONS.Save, ImageColor3 = Theme.TextSecondary, Parent = saveBtn })

	local searchBar = create("Frame", { Size = UDim2.fromOffset(160, 40), BackgroundColor3 = Theme.Search, LayoutOrder = 1, Parent = actionContainer })
	create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = searchBar })
	local searchIcon = create("ImageLabel", { Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 12, 0.5, -8), BackgroundTransparency = 1, Image = ICONS.Search, ImageColor3 = Theme.TextSecondary, Parent = searchBar })
	local searchBox = create("TextBox", { Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(36, 0), BackgroundTransparency = 1, Text = "", PlaceholderText = "Search...", TextColor3 = Theme.TextPrimary, PlaceholderColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = searchBar })

	local contentArea = create("Frame", { Size = UDim2.new(1, 0, 1, -64), BackgroundTransparency = 1, Parent = mainFrame })
	local searchContent = create("ScrollingFrame", { Size = UDim2.new(1, -40, 1, -40), Position = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = Theme.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = contentArea })
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = searchContent })
	local noResults = create("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "No results found", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 16, Visible = false, Parent = contentArea })

	local notifyHolder = create("Frame", { Size = UDim2.new(0, 280, 1, -20), Position = UDim2.new(1, -10, 0, 10), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 6000, Parent = screenGui })
	create("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = notifyHolder })

	local Window = {
		ScreenGui = screenGui,
		Tabs = {},
		AllRows = {},
		CurrentTab = nil,
		Watermarks = {},
		Popups = {},
		Visible = true,
		_notifyOrder = 0,
	}
	table.insert(Library.Windows, Window)

	local function paintConfigButton()
		local active = Window.CurrentTab and Window.CurrentTab.IsConfig
		saveBtn.BackgroundColor3 = active and Theme.Accent or Theme.Search
		saveIcon.ImageColor3 = active and Color3.fromRGB(17, 17, 17) or Theme.TextSecondary
	end

	bindTheme(function()
		mainFrame.BackgroundColor3 = Theme.Body
		bottomBar.BackgroundColor3 = Theme.Sidebar
		profileName.TextColor3 = Theme.TextPrimary
		profileSub.TextColor3 = Theme.TextSecondary
		searchBar.BackgroundColor3 = Theme.Search
		searchIcon.ImageColor3 = Theme.TextSecondary
		searchBox.TextColor3 = Theme.TextPrimary
		searchBox.PlaceholderColor3 = Theme.TextSecondary
		searchContent.ScrollBarImageColor3 = Theme.Accent
		noResults.TextColor3 = Theme.TextSecondary
		paintConfigButton()
	end)

	---Close every open popup (dropdowns, colorpickers).
	function Window:ClosePopups(except)
		for _, popup in ipairs(self.Popups) do
			if popup ~= except and popup.IsOpen() then popup.Close() end
		end
	end

	---Show or hide the window.
	function Window:ToggleVisibility()
		self.Visible = not self.Visible
		if self.Visible then
			mainFrame.Visible = true
			tween(mainFrame, TWEEN_SMOOTH, { GroupTransparency = 0 })
		else
			self:ClosePopups()
			local t = tween(mainFrame, TWEEN_SMOOTH, { GroupTransparency = 1 })
			t.Completed:Once(function()
				if not self.Visible then mainFrame.Visible = false end
			end)
		end
		for _, watermark in ipairs(self.Watermarks) do watermark:UpdatePosition() end
	end

	---Destroy this window.
	function Window:Destroy()
		screenGui:Destroy()
		local index = table.find(Library.Windows, self)
		if index then table.remove(Library.Windows, index) end
	end

	---Show a toast notification.
	---@param opts table {Title, Content, Duration}
	function Window:Notify(opts)
		opts = opts or {}
		self._notifyOrder += 1
		local card = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Sidebar, BackgroundTransparency = 1, LayoutOrder = self._notifyOrder, ClipsDescendants = true, ZIndex = 6001, Parent = notifyHolder })
		create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = card })
		local stroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Transparency = 1, Parent = card })
		create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = card })
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = card })
		local title = create("TextLabel", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Text = opts.Title or "Notification", TextColor3 = Theme.Accent, Font = Theme.Font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, LayoutOrder = 1, ZIndex = 6002, Parent = card })
		local body = create("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = opts.Content or "", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTransparency = 1, LayoutOrder = 2, ZIndex = 6002, Parent = card })
		tween(card, TWEEN_SMOOTH, { BackgroundTransparency = 0 })
		tween(stroke, TWEEN_SMOOTH, { Transparency = 0 })
		tween(title, TWEEN_SMOOTH, { TextTransparency = 0 })
		tween(body, TWEEN_SMOOTH, { TextTransparency = 0 })
		task.delay(opts.Duration or 4, function()
			if not card.Parent then return end
			tween(card, TWEEN_SMOOTH, { BackgroundTransparency = 1 })
			tween(stroke, TWEEN_SMOOTH, { Transparency = 1 })
			tween(title, TWEEN_SMOOTH, { TextTransparency = 1 })
			local t = tween(body, TWEEN_SMOOTH, { TextTransparency = 1 })
			t.Completed:Once(function() card:Destroy() end)
		end)
	end

	track(userInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Library.ToggleKey then Window:ToggleVisibility() end
	end))

	-- Single outside-click handler for every popup.
	track(userInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		for _, popup in ipairs(Window.Popups) do
			if popup.IsOpen() and not popup.Contains(position) then popup.Close() end
		end
	end))

	local function refreshWatermarks()
		for _, watermark in ipairs(Window.Watermarks) do watermark:UpdatePosition() end
	end
	mainFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(refreshWatermarks)
	mainFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshWatermarks)

	---Create a watermark pinned to the window or the screen.
	---@param initialText string
	function Window:Watermark(initialText)
		local frame = create("Frame", { BackgroundColor3 = Theme.Sidebar, Size = UDim2.fromOffset(0, 26), ClipsDescendants = true, ZIndex = 5000, Parent = screenGui })
		create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = frame })
		local stroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = frame })
		local accent = create("Frame", { BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), ZIndex = 5001, Parent = frame })
		create("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0), NumberSequenceKeypoint.new(0.85, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = accent })
		local label = create("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = initialText or "", RichText = true, TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = 13, ZIndex = 5001, Parent = frame })
		create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = label })

		bindTheme(function()
			frame.BackgroundColor3 = Theme.Sidebar
			stroke.Color = Theme.Border
			accent.BackgroundColor3 = Theme.Accent
			label.TextColor3 = Theme.TextPrimary
		end)

		local watermark = { Frame = frame, PosString = "TopLeft", CurrentText = initialText or "" }

		function watermark:UpdateSize()
			local clean = string.gsub(self.CurrentText, "<[^>]->", "")
			local width = textService:GetTextSize(clean, 13, Enum.Font.Code, Vector2.new(10000, 26)).X
			frame.Size = UDim2.fromOffset(width + 24, 26)
		end

		function watermark:SetText(text)
			self.CurrentText = text
			label.Text = text
			self:UpdateSize()
			self:UpdatePosition()
		end

		function watermark:SetVisible(state)
			frame.Visible = state
		end

		function watermark:UpdatePosition()
			local pos = self.PosString
			local wmSize = frame.AbsoluteSize
			if Window.Visible then
				local mfPos, mfSize, pad = mainFrame.AbsolutePosition, mainFrame.AbsoluteSize, 8
				if pos == "TopLeft" then
					frame.AnchorPoint = Vector2.new(0, 0)
					frame.Position = UDim2.fromOffset(mfPos.X, mfPos.Y - wmSize.Y - pad)
				elseif pos == "TopRight" then
					frame.AnchorPoint = Vector2.new(1, 0)
					frame.Position = UDim2.fromOffset(mfPos.X + mfSize.X, mfPos.Y - wmSize.Y - pad)
				elseif pos == "BottomLeft" then
					frame.AnchorPoint = Vector2.new(0, 0)
					frame.Position = UDim2.fromOffset(mfPos.X, mfPos.Y + mfSize.Y + pad)
				elseif pos == "BottomRight" then
					frame.AnchorPoint = Vector2.new(1, 0)
					frame.Position = UDim2.fromOffset(mfPos.X + mfSize.X, mfPos.Y + mfSize.Y + pad)
				end
			else
				if pos == "TopLeft" then
					frame.AnchorPoint = Vector2.new(0, 0)
					frame.Position = UDim2.fromOffset(15, 15)
				elseif pos == "TopRight" then
					frame.AnchorPoint = Vector2.new(1, 0)
					frame.Position = UDim2.new(1, -15, 0, 15)
				elseif pos == "BottomLeft" then
					frame.AnchorPoint = Vector2.new(0, 1)
					frame.Position = UDim2.new(0, 15, 1, -15)
				elseif pos == "BottomRight" then
					frame.AnchorPoint = Vector2.new(1, 1)
					frame.Position = UDim2.new(1, -15, 1, -15)
				end
			end
		end

		function watermark:SetPosition(pos)
			self.PosString = pos
			self:UpdatePosition()
		end

		frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() watermark:UpdatePosition() end)
		watermark:UpdateSize()
		watermark:SetPosition("TopLeft")
		table.insert(Window.Watermarks, watermark)
		return watermark
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local query = string.lower(searchBox.Text)
		for _, entry in ipairs(Window.AllRows) do
			entry.Row.Parent = entry.OriginalParent
		end
		local current = Window.CurrentTab
		if query == "" then
			searchContent.Visible = false
			noResults.Visible = false
			if current then current.Canvas.Visible = true end
			return
		end
		if current then current.Canvas.Visible = false end
		searchContent.Visible = true
		local found = 0
		for _, entry in ipairs(Window.AllRows) do
			if string.find(string.lower(entry.Title), query, 1, true) then
				entry.Row.Parent = searchContent
				found += 1
			end
		end
		noResults.Visible = found == 0
	end)

	---Create a tab.
	---@param options table {Title, Icon, IsConfig}
	function Window:Tab(options)
		options = options or {}
		local tabTitle = options.Title or "Tab"
		local isConfig = options.IsConfig or false

		local tabBtn
		if isConfig then
			tabBtn = saveBtn
		else
			tabBtn = create("TextButton", { Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, BackgroundColor3 = Theme.Search, Text = "", AutoButtonColor = false, Parent = tabNav })
			create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = tabBtn })
			create("ImageLabel", { Name = "Icon", Size = UDim2.fromOffset(20, 20), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Image = options.Icon or ICONS.Placeholder, ImageColor3 = Theme.TextSecondary, Parent = tabBtn })
		end

		local canvas = create("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false, Parent = contentArea })
		local container = create("ScrollingFrame", { Size = UDim2.new(1, -40, 1, -40), Position = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = Theme.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = canvas })
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = container })

		local Tab = { Canvas = canvas, Container = container, TabButton = tabBtn, Title = tabTitle, IsConfig = isConfig, LayoutOrder = 0 }
		table.insert(Window.Tabs, Tab)

		local function paint(animate)
			local active = Window.CurrentTab == Tab
			if isConfig then
				paintConfigButton()
				return
			end
			local icon = tabBtn:FindFirstChild("Icon")
			local goal = { BackgroundTransparency = active and 0 or 1 }
			local iconGoal = { ImageColor3 = active and Theme.Accent or Theme.TextSecondary }
			tabBtn.BackgroundColor3 = Theme.Search
			if animate then
				tween(tabBtn, TWEEN_FAST, goal)
				tween(icon, TWEEN_FAST, iconGoal)
			else
				tabBtn.BackgroundTransparency = goal.BackgroundTransparency
				icon.ImageColor3 = iconGoal.ImageColor3
			end
		end
		bindTheme(function()
			container.ScrollBarImageColor3 = Theme.Accent
			paint(false)
		end)

		---Switch to this tab.
		function Tab:Activate()
			local old = Window.CurrentTab
			if old == Tab then return end
			Window:ClosePopups()
			Window.CurrentTab = Tab
			if old then
				tween(old.Canvas, TWEEN_SMOOTH, { GroupTransparency = 1 })
				task.delay(0.25, function()
					if Window.CurrentTab ~= old then old.Canvas.Visible = false end
				end)
				if old.Repaint then old.Repaint(true) end
			end
			canvas.Visible = searchBox.Text == ""
			canvas.GroupTransparency = old and 1 or 0
			tween(canvas, TWEEN_SMOOTH, { GroupTransparency = 0 })
			paint(true)
		end
		Tab.Repaint = paint

		if isConfig then
			saveBtn.MouseButton1Click:Connect(function() Tab:Activate() end)
		else
			tabBtn.MouseButton1Click:Connect(function() Tab:Activate() end)
			if not Window.CurrentTab then Tab:Activate() end
		end

		local function createRow(title, height)
			Tab.LayoutOrder += 1
