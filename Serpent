			---Slider with a value pill riding the handle. Options: Min, Max, Decimal, Prefix, Suffix, Dual, Default, Settings (gear callback), Checkbox.
			function H:Slider(opts)
				opts = opts or {}
				local title = opts.Title or "Slider"
				local min, max = opts.Min or 0, opts.Max or 100
				local decimal = opts.Decimal or 0
				local prefix, suffix = opts.Prefix or "", opts.Suffix or ""
				local dual = opts.Dual or false
				local callback = opts.Callback or function() end

				local current
				if dual then
					local d = type(opts.Default) == "table" and opts.Default or {}
					current = { math.clamp(d[1] or min, min, max), math.clamp(d[2] or max, min, max) }
				else
					current = math.clamp(opts.Default or min, min, max)
				end

				local row = newRow(41)
				local titleLabel = create("TextLabel", { Size = UDim2.new(1, -24, 0, 16), BackgroundTransparency = 1, Text = title, TextColor3 = Theme.NavText, Font = Theme.Font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })

				if opts.Settings then
					local gear = create("ImageButton", { Size = UDim2.fromOffset(15, 15), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 1), BackgroundTransparency = 1, ImageColor3 = Theme.TextSecondary, Parent = row })
					setIcon(gear, Library.Icons.Gear)
					gear.MouseEnter:Connect(function() tween(gear, TWEEN_SMOOTH, { Rotation = 90, ImageColor3 = Theme.TextPrimary }) end)
					gear.MouseLeave:Connect(function() tween(gear, TWEEN_SMOOTH, { Rotation = 0, ImageColor3 = Theme.TextSecondary }) end)
					gear.MouseButton1Click:Connect(opts.Settings)
				end

				local reserve = opts.Checkbox and 22 or 0
				local track = create("Frame", { Size = UDim2.new(1, -reserve, 0, 3), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(0, 28), BackgroundColor3 = Theme.Track, BorderSizePixel = 0, Parent = row })
				corner(track, 3)
				local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = track })
				corner(fill, 3)
				local fillGradient = create("UIGradient", { Parent = fill })
				local pill = create("TextLabel", { Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Theme.Accent, Text = "", TextColor3 = Theme.AccentText, Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 3, Parent = track })
				corner(pill, 9)
				create("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9), Parent = pill })
				local pillScale = create("UIScale", { Parent = pill })
				local hit = create("TextButton", { Size = UDim2.new(1, -reserve, 0, 22), Position = UDim2.fromOffset(0, 17), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row })

				local check
				if opts.Checkbox then
					local holder = create("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, 0, 0, 28), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Parent = row })
					check = makeCheck(holder, opts.CheckboxDefault, opts.OnCheck, 14)
				end

				bindTheme(function()
					titleLabel.TextColor3 = Theme.NavText
					track.BackgroundColor3 = Theme.Track
					fill.BackgroundColor3 = Theme.Accent
					fillGradient.Color = ColorSequence.new(Theme.Accent:Lerp(Color3.new(0, 0, 0), 0.18), Theme.Accent)
					pill.BackgroundColor3 = Theme.Accent
					pill.TextColor3 = Theme.AccentText
				end)

				local function fmt(value)
					return string.format("%s%." .. decimal .. "f%s", prefix, value, suffix)
				end
				local function visuals(animate)
					local info = animate and TWEEN_DRAG or TweenInfo.new(0)
					if dual then
						local a1, a2 = (current[1] - min) / (max - min), (current[2] - min) / (max - min)
						local center = (a1 + a2) / 2
						tween(fill, info, { Position = UDim2.fromScale(a1, 0), Size = UDim2.fromScale(a2 - a1, 1) })
						pill.Text = fmt(current[1]) .. " - " .. fmt(current[2])
						tween(pill, info, { AnchorPoint = Vector2.new(center, 0.5), Position = UDim2.fromScale(center, 0.5) })
					else
						local a = (current - min) / (max - min)
						tween(fill, info, { Size = UDim2.fromScale(a, 1) })
						pill.Text = fmt(current)
						tween(pill, info, { AnchorPoint = Vector2.new(a, 0.5), Position = UDim2.fromScale(a, 0.5) })
					end
				end

				local function setValue(value, fire)
					if dual then
						value = type(value) == "table" and value or { min, max }
						current = { math.clamp(value[1], min, max), math.clamp(value[2], min, max) }
					else
						current = math.clamp(value, min, max)
					end
					visuals(true)
					if fire then callback(current) end
				end

				local dragging, hovering = false, false
				local function refreshTrack()
					local active = dragging or hovering
					tween(track, TWEEN_FAST, { Size = UDim2.new(1, -reserve, 0, active and 5 or 3) })
					tween(titleLabel, TWEEN_FAST, { TextColor3 = active and Theme.TextPrimary or Theme.NavText })
				end
				hit.MouseEnter:Connect(function() hovering = true refreshTrack() end)
				hit.MouseLeave:Connect(function() hovering = false refreshTrack() end)

				local activeHandle = 1
				local function fromInput(input)
					local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
					local mult = 10 ^ decimal
					local value = math.clamp(math.round((min + (max - min) * alpha) * mult) / mult, min, max)
					if dual then
						local new = { current[1], current[2] }
						new[activeHandle] = value
						if activeHandle == 1 and new[1] > new[2] then new[1] = new[2] end
						if activeHandle == 2 and new[2] < new[1] then new[2] = new[1] end
						setValue(new, true)
					else
						setValue(value, true)
					end
				end

				hit.InputBegan:Connect(function(input)
					if not isPress(input) then return end
					if dual then
						local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
						local a1, a2 = (current[1] - min) / (max - min), (current[2] - min) / (max - min)
						local d1, d2 = math.abs(alpha - a1), math.abs(alpha - a2)
						activeHandle = (d1 == d2 and (alpha > a1 and 2 or 1)) or (d1 < d2 and 1 or 2)
					end
					dragging = true
					refreshTrack()
					tween(pillScale, TWEEN_POP, { Scale = 1.12 })
					fromInput(input)
					local moveConn, endConn
					moveConn = userInputService.InputChanged:Connect(function(move)
						if move.UserInputType == Enum.UserInputType.MouseMovement or move.UserInputType == Enum.UserInputType.Touch then fromInput(move) end
					end)
					endConn = userInputService.InputEnded:Connect(function(finish)
						if isPress(finish) then
							moveConn:Disconnect()
							endConn:Disconnect()
							dragging = false
							refreshTrack()
							tween(pillScale, TWEEN_SMOOTH, { Scale = 1 })
						end
					end)
				end)

				visuals(false)
				local object = { Row = row }
				function object:GetComponentType() return "Slider" end
				function object:GetValue() return current end
				function object:SetValue(value) setValue(value, true) end
				function object:GetChecked() return check and check.Get() end
				function object:SetChecked(value) if check then check.Set(value, true) end end
				return register(flagName(opts, "Slider", title), object)
			end

