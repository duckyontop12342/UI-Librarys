			---Slider with a value pill riding the handle. Options: Min, Max, Decimal, Prefix, Suffix, Dual, Default, Settings (gear callback), Checkbox.
			function H:Slider(opts)
				opts = opts or {}
				local title = opts.Title or "Slider"
				local min, max = opts.Min or 0, opts.Max or 100
				local decimal = opts.Decimal or 0
				local prefix, suffix = opts.Prefix or "", opts.Suffix or ""
				local dual = opts.Dual or false
				local callback = opts.Callback or function() end

				local current
				if dual then
					local d = type(opts.Default) == "table" and opts.Default or {}
					current = { math.clamp(d[1] or min, min, max), math.clamp(d[2] or max, min, max) }
				else
					current = math.clamp(opts.Default or min, min, max)
				end

				local row = newRow(48)
				local titleLabel = create("TextLabel", { Size = UDim2.new(1, -24, 0, 16), BackgroundTransparency = 1, Text = title, TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })

				if opts.Settings then
					local gear
					if Library.Icons.Gear then
						gear = create("ImageButton", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Image = Library.Icons.Gear, ImageColor3 = Theme.TextSecondary, Parent = row })
						gear.MouseEnter:Connect(function() tween(gear, TWEEN_SMOOTH, { Rotation = 90, ImageColor3 = Theme.TextPrimary }) end)
						gear.MouseLeave:Connect(function() tween(gear, TWEEN_SMOOTH, { Rotation = 0, ImageColor3 = Theme.TextSecondary }) end)
					else
						gear = create("TextButton", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Text = "⚙", TextColor3 = Theme.TextSecondary, TextSize = 15, Font = Theme.Font, Parent = row })
						gear.MouseEnter:Connect(function() tween(gear, TWEEN_SMOOTH, { Rotation = 90, TextColor3 = Theme.TextPrimary }) end)
						gear.MouseLeave:Connect(function() tween(gear, TWEEN_SMOOTH, { Rotation = 0, TextColor3 = Theme.TextSecondary }) end)
					end
					gear.MouseButton1Click:Connect(opts.Settings)
				end

				local reserve = opts.Checkbox and 32 or 0
				local track = create("Frame", { Size = UDim2.new(1, -reserve, 0, 3), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(0, 33), BackgroundColor3 = Theme.Track, BorderSizePixel = 0, Parent = row })
				corner(track, 3)
				local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = track })
				corner(fill, 3)
				local fillGradient = create("UIGradient", { Parent = fill })
				local pill = create("TextLabel", { Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Theme.Accent, Text = "", TextColor3 = Theme.AccentText, Font = Enum.Font.GothamBold, TextSize = 11, ZIndex = 3, Parent = track })
				corner(pill, 9)
				create("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9), Parent = pill })
				local pillScale = create("UIScale", { Parent = pill })
				local hit = create("TextButton", { Size = UDim2.new(1, -reserve, 0, 22), Position = UDim2.fromOffset(0, 22), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = row })

				local check
				if opts.Checkbox then
					local holder = create("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, 0, 0, 33), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Parent = row })
					check = makeCheck(holder, opts.CheckboxDefault, opts.OnCheck)
				end

				bindTheme(function()
					titleLabel.TextColor3 = Theme.TextSecondary
					track.BackgroundColor3 = Theme.Track
					fill.BackgroundColor3 = Theme.Accent
					fillGradient.Color = ColorSequence.new(Theme.Accent:Lerp(Color3.new(0, 0, 0), 0.18), Theme.Accent)
					pill.BackgroundColor3 = Theme.Accent
					pill.TextColor3 = Theme.AccentText
				end)

				local function fmt(value)
					return string.format("%s%." .. decimal .. "f%s", prefix, value, suffix)
				end
				local function visuals(animate)
					local info = animate and TWEEN_DRAG or TweenInfo.new(0)
					if dual then
						local a1, a2 = (current[1] - min) / (max - min), (current[2] - min) / (max - min)
						local center = (a1 + a2) / 2
						tween(fill, info, { Position = UDim2.fromScale(a1, 0), Size = UDim2.fromScale(a2 - a1, 1) })
						pill.Text = fmt(current[1]) .. " - " .. fmt(current[2])
						tween(pill, info, { AnchorPoint = Vector2.new(center, 0.5), Position = UDim2.fromScale(center, 0.5) })
					else
						local a = (current - min) / (max - min)
						tween(fill, info, { Size = UDim2.fromScale(a, 1) })
						pill.Text = fmt(current)
						tween(pill, info, { AnchorPoint = Vector2.new(a, 0.5), Position = UDim2.fromScale(a, 0.5) })
					end
				end

				local function setValue(value, fire)
					if dual then
						value = type(value) == "table" and value or { min, max }
						current = { math.clamp(value[1], min, max), math.clamp(value[2], min, max) }
					else
						current = math.clamp(value, min, max)
					end
					visuals(true)
					if fire then callback(current) end
				end

				local dragging, hovering = false, false
				local function refreshTrack()
					local active = dragging or hovering
					tween(track, TWEEN_FAST, { Size = UDim2.new(1, -reserve, 0, active and 5 or 3) })
					tween(titleLabel, TWEEN_FAST, { TextColor3 = active and Theme.TextPrimary or Theme.TextSecondary })
				end
				hit.MouseEnter:Connect(function() hovering = true refreshTrack() end)
				hit.MouseLeave:Connect(function() hovering = false refreshTrack() end)

				local activeHandle = 1
				local function fromInput(input)
					local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
					local mult = 10 ^ decimal
					local value = math.clamp(math.round((min + (max - min) * alpha) * mult) / mult, min, max)
					if dual then
						local new = { current[1], current[2] }
						new[activeHandle] = value
						if activeHandle == 1 and new[1] > new[2] then new[1] = new[2] end
						if activeHandle == 2 and new[2] < new[1] then new[2] = new[1] end
						setValue(new, true)
					else
						setValue(value, true)
					end
				end

				hit.InputBegan:Connect(function(input)
					if not isPress(input) then return end
					if dual then
						local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
						local a1, a2 = (current[1] - min) / (max - min), (current[2] - min) / (max - min)
						local d1, d2 = math.abs(alpha - a1), math.abs(alpha - a2)
						activeHandle = (d1 == d2 and (alpha > a1 and 2 or 1)) or (d1 < d2 and 1 or 2)
					end
					dragging = true
					refreshTrack()
					tween(pillScale, TWEEN_POP, { Scale = 1.14 })
					fromInput(input)
					local moveConn, endConn
					moveConn = userInputService.InputChanged:Connect(function(move)
						if move.UserInputType == Enum.UserInputType.MouseMovement or move.UserInputType == Enum.UserInputType.Touch then fromInput(move) end
					end)
					endConn = userInputService.InputEnded:Connect(function(finish)
						if isPress(finish) then
							moveConn:Disconnect()
							endConn:Disconnect()
							dragging = false
							refreshTrack()
							tween(pillScale, TWEEN_SMOOTH, { Scale = 1 })
						end
					end)
				end)

				visuals(false)
				local object = { Row = row }
				function object:GetComponentType() return "Slider" end
				function object:GetValue() return current end
				function object:SetValue(value) setValue(value, true) end
				function object:GetChecked() return check and check.Get() end
				function object:SetChecked(value) if check then check.Set(value, true) end end
				return register(flagName(opts, "Slider", title), object)
			end

			---Wide dropdown. Title is the placeholder; Width in pixels is optional.
			function H:Dropdown(opts)
				opts = opts or {}
				local row = newRow(36)
				local api = buildDropdown(Window, row, opts, false)
				api.Row = row
				return register(flagName(opts, "Dropdown", opts.Title or "Dropdown"), api)
			end

			---Row of pill buttons with an optional checkbox on the right.
			function H:Pills(opts)
				opts = opts or {}
				local options = opts.Options or {}
				local callback = opts.Callback or function() end
				local current = opts.Default or options[1]
				local row = newRow(34)
				local holder = create("Frame", { Size = UDim2.new(1, opts.Checkbox and -34 or 0, 1, 0), BackgroundTransparency = 1, Parent = row })
				create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = holder })

				local pills, scales = {}, {}
				local function paint(animate)
					for name, pill in pairs(pills) do
						local active = name == current
						local goal = { BackgroundTransparency = active and 0 or 1, TextColor3 = active and Theme.AccentText or Theme.TextSecondary, BackgroundColor3 = Theme.Accent }
						if animate then
							tween(pill, TWEEN_SMOOTH, goal)
						else
							for key, value in pairs(goal) do pill[key] = value end
						end
					end
				end
				bindTheme(function() paint(false) end)

				local function setValue(value, fire)
					if not pills[value] then return end
					current = value
					paint(true)
					scales[value].Scale = 0.88
					tween(scales[value], TWEEN_POP, { Scale = 1 })
					if fire then callback(current) end
				end

				for order, name in ipairs(options) do
					local pill = create("TextButton", { Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, Text = name, Font = Theme.Font, TextSize = 12, AutoButtonColor = false, LayoutOrder = order, BackgroundColor3 = Theme.Accent, Parent = holder })
					corner(pill, 14)
					create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = pill })
					pills[name] = pill
					scales[name] = addPress(pill, 0.94)
					pill.MouseEnter:Connect(function()
						if name ~= current then tween(pill, TWEEN_FAST, { TextColor3 = Theme.TextPrimary }) end
					end)
					pill.MouseLeave:Connect(function()
						if name ~= current then tween(pill, TWEEN_FAST, { TextColor3 = Theme.TextSecondary }) end
					end)
					pill.MouseButton1Click:Connect(function() setValue(name, true) end)
				end
				paint(false)

				local check
				if opts.Checkbox then
					local box = create("Frame", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromScale(1, 0.5), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Parent = row })
					check = makeCheck(box, opts.CheckboxDefault, opts.OnCheck)
				end

				local object = { Row = row }
				function object:GetComponentType() return "Pills" end
				function object:GetValue() return current end
				function object:SetValue(value) setValue(value, true) end
				function object:GetChecked() return check and check.Get() end
				function object:SetChecked(value) if check then check.Set(value, true) end end
				return register(flagName(opts, "Pills", opts.Title or "Pills"), object)
			end

			---Body silhouette with a compact dropdown. Parts: Head, Chest, Stomach, Arms, Legs.
			function H:BodySelector(opts)
				opts = opts or {}
				local parts = opts.Parts or { "Head", "Chest", "Stomach", "Arms", "Legs" }
				local callback = opts.Callback or function() end
				local current = opts.Default or "Chest"

				local row = newRow(224)
				create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = row })
				local moveDot
				local drop = buildDropdown(Window, row, { Options = parts, Default = current, Width = 88, Callback = function(value)
					current = value
					if moveDot then moveDot(value, 1) end
					callback(value)
				end }, true)
				drop.Button.LayoutOrder = 1

				local panel = create("Frame", { Size = UDim2.fromOffset(128, 190), BackgroundColor3 = Theme.Surface, LayoutOrder = 2, Parent = row })
				corner(panel, 8)
				local panelStroke = create("UIStroke", { Color = Theme.Border, Thickness = 1, Transparency = 0.4, Parent = panel })
				create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.25) }), Parent = panel })

				local shapes = {
					Head = { { 51, 24, 26, 26, 13 } },
					Chest = { { 42, 56, 44, 28, 6 } },
					Stomach = { { 42, 86, 44, 28, 6 } },
					Arms = { { 26, 58, 12, 56, 6 }, { 90, 58, 12, 56, 6 } },
					Legs = { { 43, 118, 20, 64, 6 }, { 65, 118, 20, 64, 6 } },
				}
				local base, lit = Color3.fromRGB(88, 88, 96), Color3.fromRGB(150, 150, 160)

				local ring = create("Frame", { Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 4, Parent = panel })
				corner(ring, 20)
				local ringStroke = create("UIStroke", { Color = Theme.Accent, Thickness = 2, Transparency = 1, Parent = ring })
				local dot = create("Frame", { Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.Accent, ZIndex = 5, Parent = panel })
				corner(dot, 4)

				local pieces = {}
				local function paintPieces()
					for part, list in pairs(pieces) do
						for _, piece in ipairs(list) do
							tween(piece, TWEEN_SMOOTH, { BackgroundColor3 = part == current and lit or base })
						end
					end
				end

				function moveDot(part, index)
					local spec = shapes[part] and shapes[part][index or 1]
					if not spec then return end
					local target = UDim2.fromOffset(spec[1] + spec[3] / 2, spec[2] + spec[4] / 2)
					tween(dot, TWEEN_SMOOTH, { Position = target })
					ring.Position = target
					ring.Size = UDim2.fromOffset(8, 8)
					ringStroke.Transparency = 0.1
					tween(ring, TWEEN_SLOW, { Size = UDim2.fromOffset(34, 34) })
					tween(ringStroke, TWEEN_SLOW, { Transparency = 1 })
					paintPieces()
				end

				for _, part in ipairs(parts) do
					pieces[part] = {}
					for index, spec in ipairs(shapes[part] or {}) do
						local piece = create("TextButton", { Position = UDim2.fromOffset(spec[1], spec[2]), Size = UDim2.fromOffset(spec[3], spec[4]), BackgroundColor3 = part == current and lit or base, Text = "", AutoButtonColor = false, Parent = panel })
						corner(piece, spec[5])
						table.insert(pieces[part], piece)
						piece.MouseEnter:Connect(function()
							if part ~= current then tween(piece, TWEEN_FAST, { BackgroundColor3 = lighten(base, 0.18) }) end
						end)
						piece.MouseLeave:Connect(function()
							if part ~= current then tween(piece, TWEEN_FAST, { BackgroundColor3 = base }) end
						end)
						piece.MouseButton1Click:Connect(function()
							drop:SetValue(part)
							moveDot(part, index)
						end)
					end
				end

				bindTheme(function()
					panel.BackgroundColor3 = Theme.Surface
					panelStroke.Color = Theme.Border
					dot.BackgroundColor3 = Theme.Accent
					ringStroke.Color = Theme.Accent
				end)
				task.defer(function()
					local spec = shapes[current] and shapes[current][1]
					if spec then dot.Position = UDim2.fromOffset(spec[1] + spec[3] / 2, spec[2] + spec[4] / 2) end
				end)

				local object = { Row = row }
				function object:GetComponentType() return "BodySelector" end
				function object:GetValue() return current end
				function object:SetValue(value) drop:SetValue(value) end
				return register(flagName(opts, "Body", opts.Title or "Body"), object)
			end

			function H:Colorpicker(opts)
				opts = opts or {}
				local title = opts.Title or "Colorpicker"
				local row = newRow(30)
				rowTitle(row, title, 180)
				local object = attachColorPicker(row, title, opts, 0)
				object.Row = row
				return object
			end

			---Two side-by-side columns. Returns left, right holders with the same component methods.
			function H:Split(opts)
				opts = opts or {}
				local leftWidth, gap = opts.LeftWidth or 128, opts.Gap or 20
				H._order += 1
				local row = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = H._order, Parent = container })
				create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
				local function column(width, order)
					local frame = create("Frame", { Size = width, AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order, Parent = row })
					create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 12), Parent = frame })
					return attach({}, frame)
				end
				return column(UDim2.fromOffset(leftWidth, 0), 1), column(UDim2.new(1, -(leftWidth + gap), 0, 0), 2)
			end

			return H
		end

		return attach(Tab, page)
	end

	---Fill a Config tab with save/load/delete, UI keybind and unload controls.
	function Window:SetupConfig(folder)
		folder = folder or "serpent"
		if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end

		local tab = self:Tab({ Title = "Config" })
		self.ConfigTab = tab
		local function getList()
			local names = {}
			if listfiles then
				for _, path in ipairs(listfiles(folder)) do
					local name = path:match("([^/\\]+)%.json$")
					if name then table.insert(names, name) end
				end
			end
			return names
		end

		tab:Section("Configs")
		local dropdown = tab:Dropdown({ Title = "Select config", Options = getList(), Flag = "Config_List", Width = 190 })
		local nameBox = tab:Textbox({ Title = "Config name", Placeholder = "myconfig", Flag = "Config_Name" })
		tab:Button({ Title = "Load config", Action = "Load", Callback = function()
			local name = dropdown:GetValue()
			if not name then return self:Notify({ Title = "Config", Content = "Select a config first." }) end
			local ok = Library:LoadFlags(readfile(string.format("%s/%s.json", folder, name)))
			self:Notify({ Title = "Config", Content = ok and ("Loaded " .. name) or "Failed to load config." })
		end })
		tab:Button({ Title = "Save config", Action = "Save", Callback = function()
			local name = nameBox:GetValue()
			if name == "" then return self:Notify({ Title = "Config", Content = "Enter a config name." }) end
			writefile(string.format("%s/%s.json", folder, name), Library:SerializeFlags())
			dropdown:SetOptions(getList())
			self:Notify({ Title = "Config", Content = "Saved " .. name })
		end })
		tab:Button({ Title = "Delete config", Action = "Delete", Callback = function()
			local name = dropdown:GetValue()
			if not name then return end
			delfile(string.format("%s/%s.json", folder, name))
			dropdown:SetOptions(getList())
			self:Notify({ Title = "Config", Content = "Deleted " .. name })
		end })
		tab:Divider()
		tab:Keybind({ Title = "Toggle window", Default = Library.ToggleKey, Flag = "Config_ToggleKey", Callback = function(key)
			if key.EnumType == Enum.KeyCode then Library:SetWindowKeybind(key) end
		end })
		tab:Button({ Title = "Unload", Action = "Unload", Callback = function() Library:Unload() end })
		return tab
	end

	return Window
end

return Library
