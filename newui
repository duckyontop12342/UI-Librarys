---Place a popup below its anchor, or above when there is no room.
---@param popup Frame
---@param anchor GuiObject
---@param alignRight boolean?
function Window:placePopup(popup, anchor, alignRight)
	local scale = self.scale.Scale
	local overlayPosition = self.overlay.AbsolutePosition
	local anchorPosition = anchor.AbsolutePosition
	local anchorSize = anchor.AbsoluteSize

	local width = popup.Size.X.Offset
	local height = popup.Size.Y.Offset
	local x = (anchorPosition.X - overlayPosition.X) / scale
	if alignRight then
		x = (anchorPosition.X + anchorSize.X - overlayPosition.X) / scale - width
	end

	local y = (anchorPosition.Y - overlayPosition.Y + anchorSize.Y) / scale + 8
	if y + height > WINDOW_HEIGHT - 12 then
		y = (anchorPosition.Y - overlayPosition.Y) / scale - height - 8
	end

	x = math.clamp(x, 8, WINDOW_WIDTH - width - 8)
	popup.Position = UDim2.fromOffset(x, math.max(8, y))
end

---Open the shared list popup under an anchor.
---@param anchor GuiObject
---@param entries table
---@param isSelected function
---@param onPick function
---@param keepOpen boolean
function Window:showList(anchor, entries, isSelected, onPick, keepOpen)
	self:closePopups()

	for _, child in ipairs(self.listContainer:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local itemHeight = 44
	local scale = self.scale.Scale
	local visibleCount = math.max(1, math.min(#entries, 6))
	self.listPopup.Size = UDim2.fromOffset(anchor.AbsoluteSize.X / scale, visibleCount * itemHeight + 12)

	local buttons = {}
	local function restyle()
		for entry, parts in pairs(buttons) do
			local selected = isSelected(entry)
			parts.label.TextColor3 = selected and Theme.accentLight or Theme.textPrimary
			parts.check.ImageTransparency = selected and 0 or 1
		end
	end

	for index, entry in ipairs(entries) do
		local button = create("TextButton", {
			Name = tostring(entry),
			Size = UDim2.new(1, 0, 0, itemHeight),
			BackgroundTransparency = 1,
			BackgroundColor3 = Theme.elementBackground,
			LayoutOrder = index,
			ZIndex = 52,
		}, self.listContainer)
		round(button, 10)

		local label = create("TextLabel", {
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -52, 1, 0),
			Text = tostring(entry),
			TextSize = 19,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 53,
		}, button)

		local check = createIcon(button, "check", 20, Theme.accentLight, "ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -22, 0.5, 0),
			ZIndex = 53,
		})

		buttons[entry] = { label = label, check = check }

		button.MouseEnter:Connect(function()
			tween(button, 0.1, { BackgroundTransparency = 0 })
		end)
		button.MouseLeave:Connect(function()
			tween(button, 0.1, { BackgroundTransparency = 1 })
		end)
		button.Activated:Connect(function()
			onPick(entry)
			if keepOpen then
				restyle()
			else
				self:closePopups()
			end
		end)
	end

	restyle()
	self.listContainer.CanvasPosition = Vector2.zero
	self.listAnchor = anchor
	self.overlay.Visible = true
	self:placePopup(self.listPopup, anchor, false)
	self.listPopup.Visible = true
	self.activePopup = self.listPopup
end

---Open the shared colour picker next to an anchor.
---@param anchor GuiObject
---@param color Color3
---@param onChange function
function Window:showColor(anchor, color, onChange)
	self:closePopups()
	self.loadColor(color)
	self.colorContext = onChange
	self.overlay.Visible = true
	self:placePopup(self.colorPopup, anchor, true)
	self.colorPopup.Visible = true
	self.activePopup = self.colorPopup
end

---Close any open popup.
function Window:closePopups()
	self.listPopup.Visible = false
	self.colorPopup.Visible = false
	self.overlay.Visible = false
	self.rootLayer.Visible = false
	self.listening = false
	self.bindUi.bind = nil
	self.activePopup = nil
	self.listAnchor = nil
	self.colorContext = nil

	if self.listClosed then
		local callback = self.listClosed
		self.listClosed = nil
		callback()
	end
end

