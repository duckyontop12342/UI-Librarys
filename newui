---Rebuild the binds list from toggles that are on and set to show.
function Window:refreshBinds()
	for _, child in ipairs(self.bindList:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local count = 0
	for _, entry in ipairs(self.binds) do
		if entry.bind.Key and entry.bind.ShowInBinds and entry.control.get() then
			count = count + 1
			create("TextLabel", {
				Size = UDim2.fromOffset(0, 24),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = string.format("%s  [%s]", entry.name, entry.bind.Key.Name),
				TextSize = 18,
				TextColor3 = Theme.textMuted,
				LayoutOrder = count,
			}, self.bindList)
		end
	end

	self.bindList.Visible = count > 0 and not self.hideKeybindList
end

---Show or hide the window.
---@param visible boolean
function Window:setVisible(visible)
	self.visible = visible
	self:closePopups()
	self.frame.Visible = visible
end

---Hide rows that do not match the search query on the active page.
---@param query string
function Window:applySearch(query)
	local page = self.activePage
	if not page then
		return
	end

	query = string.lower(query or "")
	for _, section in ipairs(page.sections) do
		local sectionMatch = query == "" or string.find(string.lower(section.name), query, 1, true) ~= nil
		local anyVisible = false

		for _, item in ipairs(section.items) do
			local match = sectionMatch or string.find(string.lower(item.name), query, 1, true) ~= nil
			item.row.Visible = match
			anyVisible = anyVisible or match
		end

		section.holder.Visible = anyVisible or #section.items == 0
	end
end

---Show a page and update the breadcrumb.
---@param page table?
function Window:selectPage(page)
	self:closePopups()

	for _, tab in ipairs(self.tabs) do
		for _, other in ipairs(tab.pages) do
			other.scroll.Visible = false
		end
	end

	self.activePage = page
	self.crumbTab.Text = self.activeTab and self.activeTab.name or ""
	self.crumbArrow.Visible = page ~= nil
	self.crumbPage.Text = page and page.name or ""
	self.pageText.Text = page and page.name or ""

	if page then
		page.scroll.CanvasPosition = Vector2.zero
		page.scroll.Visible = true
		self:applySearch(self.searchBox.Text)
	end
end

---Switch the active sidebar tab.
---@param tab table
function Window:selectTab(tab)
	self:closePopups()

	for _, other in ipairs(self.tabs) do
		other:setActive(other == tab)
	end

	self.activeTab = tab
	self:selectPage(tab.activePage or tab.pages[1])
end

---Add a tab to the sidebar.
---@param options table
---@return table
function Window:addTab(options)
	local tab = Tab.new(self, options)
	table.insert(self.tabs, tab)

	if not self.activeTab then
		self:selectTab(tab)
	end

	return tab
end

---Remove the interface and disconnect every connection.
function Window:destroy()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	table.clear(self.connections)
	self.gui:Destroy()
end

