---Store a connection so destroy can clean it up.
---@param signal RBXScriptSignal
---@param callback function
---@return RBXScriptConnection
function Window:connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

---Fit the fixed design canvas to the screen.
function Window:updateScale()
	local size = self.gui.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		local camera = workspace.CurrentCamera
		size = camera and camera.ViewportSize or Vector2.new(DESIGN_WIDTH, DESIGN_HEIGHT)
	end

	self.scale.Scale = math.min(size.X / DESIGN_WIDTH, size.Y / DESIGN_HEIGHT) * self.scaleMultiplier
end

---Build the top status bar.
function Window:buildWatermark()
	local watermark = create("Frame", {
		Name = "Watermark",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(925, 47),
		Size = UDim2.fromOffset(0, 54),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.watermarkBackground,
	}, self.root)
	round(watermark, 14)
	outline(watermark, Theme.border)

	create("UIPadding", {
		PaddingLeft = UDim.new(0, 26),
		PaddingRight = UDim.new(0, 25),
	}, watermark)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 19),
	}, watermark)

	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end

	local logo = createLogo(watermark, 25, UDim2.new())
	logo.LayoutOrder = nextOrder()

	create("TextLabel", {
		Name = "Title",
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = self.title,
		Font = FONT_BOLD,
		TextSize = 27,
		LayoutOrder = nextOrder(),
	}, watermark)

	local function separator()
		create("Frame", {
			Name = "Separator",
			Size = UDim2.fromOffset(1, 26),
			BackgroundColor3 = Theme.border,
			LayoutOrder = nextOrder(),
		}, watermark)
	end

	local function entry(name, text)
		return create("TextLabel", {
			Name = name,
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = text,
			Font = FONT_MEDIUM,
			TextSize = 19,
			TextColor3 = Theme.textMuted,
			LayoutOrder = nextOrder(),
		}, watermark)
	end

	separator()
	local gameLabel = entry("Game", self.options.GameName or "")
	separator()
	local fpsLabel = entry("Fps", "0 fps")
	separator()
	local pingLabel = entry("Ping", "0 ms")
	separator()
	local clockLabel = entry("Clock", os.date("%H:%M:%S"))

	if not self.options.GameName then
		task.spawn(function()
			local success, info = pcall(function()
				return marketplaceService:GetProductInfo(game.PlaceId)
			end)
			gameLabel.Text = success and info.Name or "Unknown"
		end)
	end

	-- Refresh the readouts twice per second from a single heartbeat connection.
	local frames = 0
	local elapsed = 0
	self:connect(runService.Heartbeat, function(delta)
		frames = frames + 1
		elapsed = elapsed + delta
		if elapsed < 0.5 then
			return
		end

		fpsLabel.Text = string.format("%d fps", math.floor(frames / elapsed + 0.5))
		frames = 0
		elapsed = 0

		local success, ping = pcall(function()
			return statsService.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		pingLabel.Text = string.format("%d ms", success and math.floor(ping + 0.5) or 0)
		clockLabel.Text = os.date("%H:%M:%S")
	end)

	self.watermark = watermark
end

---Build the main window frame and its drag handles.
function Window:buildWindow()
	self.frame = create("Frame", {
		Name = "Window",
		Position = UDim2.fromOffset(WINDOW_X, WINDOW_Y),
		Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT),
		BackgroundColor3 = Theme.windowBackground,
		ClipsDescendants = true,
	}, self.root)
	round(self.frame, 28)
	outline(self.frame, Theme.border, 0.35)

	local function makeDraggable(handle)
		handle.InputBegan:Connect(function(input)
			if not isPress(input) then
				return
			end

			local start = Vector2.new(input.Position.X, input.Position.Y)
			local origin = self.frame.Position
			trackDrag(input, function(position)
				local delta = (Vector2.new(position.X, position.Y) - start) / self.scale.Scale
				self.frame.Position = UDim2.fromOffset(origin.X.Offset + delta.X, origin.Y.Offset + delta.Y)
			end)
		end)
	end

	local sidebarHandle = create("Frame", {
		Name = "SidebarDragHandle",
		Size = UDim2.fromOffset(SIDEBAR_WIDTH, 84),
		BackgroundTransparency = 1,
	}, self.frame)
	local topbarHandle = create("Frame", {
		Name = "TopbarDragHandle",
		Position = UDim2.fromOffset(SIDEBAR_WIDTH, 0),
		Size = UDim2.fromOffset(WINDOW_WIDTH - SIDEBAR_WIDTH, PAGE_TOP),
		BackgroundTransparency = 1,
	}, self.frame)

	makeDraggable(sidebarHandle)
	makeDraggable(topbarHandle)
end

