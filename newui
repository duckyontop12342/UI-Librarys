		BackgroundColor3 = Theme.elementBackground,
		TextSize = 17,
		ClearTextOnFocus = false,
		ZIndex = 52,
	}, popup)
	round(hexBox, 10)

	local hue, saturation, brightness = 0, 0, 1

	local function refresh(notify)
		svBox.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
		svCursor.Position = UDim2.fromScale(saturation, 1 - brightness)
		hueCursor.Position = UDim2.fromScale(hue, 0.5)

		local color = Color3.fromHSV(hue, saturation, brightness)
		hexBox.Text = "#" .. color:ToHex()

		if notify and self.colorContext then
			self.colorContext(color)
		end
	end

	svButton.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end

		local function move(position)
			local point = pointerPosition(position)
			saturation = math.clamp((point.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
			brightness = 1 - math.clamp((point.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
			refresh(true)
		end

		move(input.Position)
		trackDrag(input, move)
	end)

	hueButton.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end

		local function move(position)
			local point = pointerPosition(position)
			hue = math.clamp((point.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 0.999)
			refresh(true)
		end

		move(input.Position)
		trackDrag(input, move)
	end)

	hexBox.FocusLost:Connect(function()
		local text = string.gsub(hexBox.Text, "%s", "")
		local success, color = pcall(Color3.fromHex, text)
		if success and color then
			hue, saturation, brightness = color:ToHSV()
		end
		refresh(success)
	end)

	self.colorPopup = popup
	self.loadColor = function(color)
		hue, saturation, brightness = color:ToHSV()
		refresh(false)
	end
end

