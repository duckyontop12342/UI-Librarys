-- State.
local lucide = nil

---Load the Lucide icon spritesheet module once per executor session.
---@return table?
local function getLucide()
	if lucide then
		return lucide
	end

	local environment = getgenv and getgenv() or _G
	if environment.EvenesceLucide then
		lucide = environment.EvenesceLucide
		return lucide
	end

	local success, result = pcall(function()
		local response = request({ Url = LUCIDE_URL, Method = "GET" })
		return loadstring(response.Body)()
	end)

	if not success or type(result) ~= "table" then
		warn("Evenesce: failed to load Lucide icons.")
		return nil
	end

	lucide = result
	environment.EvenesceLucide = result
	return lucide
end

---Create an instance with library defaults applied before the caller's properties.
---@param className string
---@param properties table?
---@param parent Instance?
---@return Instance
local function create(className, properties, parent)
	local instance = Instance.new(className)

	if instance:IsA("GuiObject") then
		instance.BorderSizePixel = 0
	end

	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		instance.BackgroundTransparency = 1
		instance.Font = FONT_MEDIUM
		instance.Text = ""
		instance.TextColor3 = Theme.textPrimary
		instance.TextSize = 19
	end

	if instance:IsA("TextButton") or instance:IsA("ImageButton") then
		instance.AutoButtonColor = false
	end

	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		instance.BackgroundTransparency = 1
	end

	if properties then
		for key, value in pairs(properties) do
			instance[key] = value
		end
	end

	instance.Parent = parent
	return instance
end

---Round the corners of a gui object.
---@param instance Instance
---@param radius number
local function round(instance, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) }, instance)
end

---Add a border stroke to a gui object.
---@param instance Instance
---@param color Color3
---@param transparency number?
local function outline(instance, color, transparency)
	return create("UIStroke", {
		Color = color,
		Thickness = 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, instance)
end

---Play a short tween on an instance.
---@param instance Instance
---@param duration number
---@param properties table
local function tween(instance, duration, properties)
	local playing = tweenService:Create(
		instance,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		properties
	)
	playing:Play()
	return playing
end

---Point an image at a Lucide icon sprite.
---@param image ImageLabel
---@param name string
local function setIcon(image, name)
	local library = getLucide()
	local asset = library and library.GetAsset(name)
	if not asset then
		image.Image = ""
		return
	end

	image.Image = asset.Url
	image.ImageRectSize = asset.ImageRectSize
	image.ImageRectOffset = asset.ImageRectOffset
end

---Create a tinted Lucide icon.
---@param parent Instance
---@param name string
---@param size number
---@param color Color3
---@param className string?
---@param properties table?
---@return ImageLabel
local function createIcon(parent, name, size, color, className, properties)
	local icon = create(className or "ImageLabel", {
		Name = "Icon",
		Size = UDim2.fromOffset(size, size),
		ImageColor3 = color,
	})

	if properties then
		for key, value in pairs(properties) do
			icon[key] = value
		end
	end

	setIcon(icon, name)
	icon.Parent = parent
	return icon
end

---Tint an icon button on hover.
---@param button GuiButton
---@param target ImageLabel
---@param normal Color3
---@param hover Color3
local function bindHoverTint(button, target, normal, hover)
	button.MouseEnter:Connect(function()
		tween(target, 0.12, { ImageColor3 = hover })
	end)
	button.MouseLeave:Connect(function()
		tween(target, 0.12, { ImageColor3 = normal })
	end)
end

---Fade a button background on hover.
---@param button GuiButton
---@param normal Color3
---@param hover Color3
local function bindHoverFill(button, normal, hover)
	button.MouseEnter:Connect(function()
		tween(button, 0.12, { BackgroundColor3 = hover })
	end)
	button.MouseLeave:Connect(function()
		tween(button, 0.12, { BackgroundColor3 = normal })
	end)
end

---Convert an input position into full-screen coordinates matching AbsolutePosition.
---@param position Vector3
---@return Vector2
local function pointerPosition(position)
	local inset = guiService:GetGuiInset()
	return Vector2.new(position.X, position.Y + inset.Y)
end

---Check whether an input should start a press interaction.
---@param input InputObject
---@return boolean
local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

---Follow the pointer until the press that started the drag is released.
---@param input InputObject
---@param onMove function
local function trackDrag(input, onMove)
	local moveConnection
	local endConnection

	moveConnection = userInputService.InputChanged:Connect(function(changed)
		if
			changed.UserInputType == Enum.UserInputType.MouseMovement
			or changed.UserInputType == Enum.UserInputType.Touch
		then
			onMove(changed.Position)
		end
	end)

	endConnection = userInputService.InputEnded:Connect(function(ended)
		if ended == input or (ended.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
			moveConnection:Disconnect()
			endConnection:Disconnect()
		end
	end)
end

---Run a callback without letting its errors stop the library.
---@param callback function?
local function fire(callback, ...)
	if callback then
		task.spawn(callback, ...)
	end
end

---Count the decimals of a slider increment.
---@param increment number
---@return number
local function getDecimals(increment)
	local fraction = string.match(tostring(increment), "%.(%d+)")
	return fraction and #fraction or 0
end

---Format a number with a fixed amount of decimals.
---@param value number
---@param decimals number
---@return string
local function formatNumber(value, decimals)
	if decimals <= 0 then
		return tostring(math.floor(value + 0.5))
	end
	return string.format("%." .. decimals .. "f", value)
end

---Snap a value to an increment and clamp it into range.
---@param value number
---@param minimum number
---@param maximum number
---@param increment number
---@param decimals number
---@return number
local function snap(value, minimum, maximum, increment, decimals)
	local snapped = math.floor((value - minimum) / increment + 0.5) * increment + minimum
	snapped = math.clamp(snapped, minimum, maximum)
	return tonumber(string.format("%." .. decimals .. "f", snapped)) or snapped
end

---Build the two-bar logo mark.
---@param parent Instance
---@param size number
---@param position UDim2
---@return Frame
local function createLogo(parent, size, position)
	local holder = create("Frame", {
		Name = "Logo",
		Position = position,
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	}, parent)

	local unit = size / 36
	local function bar(centerX, centerY, color)
		local part = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(centerX * unit, centerY * unit),
			Size = UDim2.fromOffset(30 * unit, 13 * unit),
			Rotation = -24,
			BackgroundColor3 = color,
		}, holder)
		round(part, math.max(2, math.floor(6 * unit)))
	end

	bar(20, 11, Theme.accentLight)
	bar(16, 25, Theme.accent)
	return holder
end

---Create the protected ScreenGui.
---@return ScreenGui
local function createScreenGui()
	local gui = create("ScreenGui", {
		Name = string.format("%x", math.random(0x10000000, 0x7fffffff)),
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
	})

	local container = gethui and gethui() or coreGui
	local success = pcall(function()
		gui.Parent = container
	end)

	if not success then
		gui.Parent = playersService.LocalPlayer:WaitForChild("PlayerGui")
	end

	return gui
end

