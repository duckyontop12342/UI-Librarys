---Add a checkbox row with optional arrow and settings icons.
---@param options table
---@return table
function Section:addToggle(options)
	local window = self.window
	local row = self:createRow(67, options.Name)
	local flag = options.Flag or options.Name
	local callback = options.Callback
	local value = options.Default == true

	local hit = create("TextButton", {
		Name = "Hit",
		Size = UDim2.new(1, 0, 1, -1),
	}, row)

	local checkbox = create("Frame", {
		Name = "Checkbox",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, ROW_PADDING, 0, 33),
		Size = UDim2.fromOffset(31, 31),
		BackgroundColor3 = value and Theme.accent or Theme.checkboxOff,
	}, row)
	round(checkbox, 8)

	local check = createIcon(checkbox, "check", 21, Theme.textPrimary, "ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ImageTransparency = value and 0 or 1,
	})

	local label = create("TextLabel", {
		Name = "Label",
		Position = UDim2.fromOffset(75, 0),
		Size = UDim2.new(1, -170, 0, 66),
		Text = options.Name,
		Font = FONT_MEDIUM,
		TextSize = 19,
		TextColor3 = value and Theme.textPrimary or Theme.textDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local control = {}
	local bind = {
		Key = options.Keybind,
		Mode = options.Mode == "Hold" and "Hold" or "Toggle",
		ShowInBinds = options.ShowInBinds ~= false,
	}
	control.bind = bind

	---@param newValue boolean
	---@param silent boolean?
	local function apply(newValue, silent)
		value = newValue
		Evenesce.Flags[flag] = value
		if options.Gear then
			window:refreshBinds()
		end
		tween(checkbox, 0.15, { BackgroundColor3 = value and Theme.accent or Theme.checkboxOff })
		tween(check, 0.15, { ImageTransparency = value and 0 or 1 })
		tween(label, 0.15, { TextColor3 = value and Theme.textPrimary or Theme.textDim })
		if not silent then
			fire(callback, value)
		end
	end

	Evenesce.Flags[flag] = value
	hit.Activated:Connect(function()
		apply(not value)
	end)

	if options.Gear then
		local gear = createIcon(row, "settings", 24, Theme.textMuted, "ImageButton", {
			Name = "Gear",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -40, 0, 33),
		})
		bindHoverTint(gear, gear, Theme.textMuted, Theme.textPrimary)
		gear.Activated:Connect(function()
			window:showBindPopup(gear, bind, control)
			fire(options.OnGear, value)
		end)

		window:registerBind(options.Name, bind, control)

		-- Keybind handling: press flips the toggle, hold keeps it on while the key is down.
		window:connect(userInputService.InputBegan, function(input, processed)
			if processed or window.listening or window.bindCooldown then
				return
			end
			if not bind.Key or input.KeyCode ~= bind.Key then
				return
			end
			apply(bind.Mode == "Hold" and true or not value)
		end)
		window:connect(userInputService.InputEnded, function(input)
			if bind.Mode == "Hold" and bind.Key and input.KeyCode == bind.Key then
				apply(false)
			end
		end)
	end

	if options.Arrow then
		local arrow = createIcon(row, "chevron-right", 24, Theme.textMuted, "ImageButton", {
			Name = "Arrow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -78, 0, 33),
		})
		bindHoverTint(arrow, arrow, Theme.textMuted, Theme.textPrimary)
		arrow.Activated:Connect(function()
			fire(options.OnArrow, value)
		end)
	end

	function control.set(_, newValue)
		apply(newValue == true, false)
	end

	function control.get()
		return value
	end

	return control
end

---Add a single handle slider row.
---@param options table
---@return table
function Section:addSlider(options)
	local row = self:createRow(86, options.Name)
	local flag = options.Flag or options.Name
	local callback = options.Callback
	local minimum = options.Min or 0
	local maximum = options.Max or 100
	local increment = options.Increment or 1
	local suffix = options.Suffix or ""
	local decimals = getDecimals(increment)
	local value = snap(options.Default or minimum, minimum, maximum, increment, decimals)

	self:createLabel(row, options.Name, 21)
	local valueLabel = self:createValueLabel(row, 21)

	local track = create("Frame", {
		Name = "Track",
		Position = UDim2.fromOffset(ROW_PADDING, 54),
		Size = UDim2.new(1, -(ROW_PADDING * 2 + 1), 0, 12),
		BackgroundColor3 = Theme.track,
	}, row)
	round(track, 6)

	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.accent,
	}, track)
	round(fill, 6)
	create("UIGradient", {
		Color = ColorSequence.new(Theme.accent, Theme.accentLight),
	}, fill)

	local hit = create("TextButton", {
		Name = "Hit",
		Position = UDim2.fromOffset(ROW_PADDING, 38),
		Size = UDim2.new(1, -(ROW_PADDING * 2 + 1), 0, 44),
	}, row)

	local control = {}

	local function render(animate)
		local alpha = (value - minimum) / (maximum - minimum)
		valueLabel.Text = formatNumber(value, decimals) .. suffix
		if animate then
			tween(fill, 0.1, { Size = UDim2.fromScale(alpha, 1) })
		else
			fill.Size = UDim2.fromScale(alpha, 1)
		end
	end

	local function apply(newValue, animate, silent)
		newValue = snap(newValue, minimum, maximum, increment, decimals)
		if newValue == value then
			return
		end
		value = newValue
		Evenesce.Flags[flag] = value
		render(animate)
		if not silent then
			fire(callback, value)
		end
	end

	Evenesce.Flags[flag] = value
	render(false)

	hit.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end

		local function move(position)
			local point = pointerPosition(position)
			local alpha = math.clamp((point.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			apply(minimum + (maximum - minimum) * alpha, false, false)
		end

		move(input.Position)
		trackDrag(input, move)
	end)

	function control.set(_, newValue)
		apply(newValue, true, false)
	end

	function control.get()
		return value
	end

	return control
end

---Add a two handle range slider row.
---@param options table
---@return table
function Section:addRangeSlider(options)
	local row = self:createRow(86, options.Name)
	local flag = options.Flag or options.Name
	local callback = options.Callback
	local minimum = options.Min or 0
	local maximum = options.Max or 100
	local increment = options.Increment or 1
	local suffix = options.Suffix or ""
	local decimals = getDecimals(increment)
	local default = options.Default or { minimum, maximum }
	local low = snap(default[1], minimum, maximum, increment, decimals)
	local high = snap(default[2], minimum, maximum, increment, decimals)

	self:createLabel(row, options.Name, 21)
	local valueLabel = self:createValueLabel(row, 21)

	local track = create("Frame", {
		Name = "Track",
		Position = UDim2.fromOffset(ROW_PADDING, 54),
		Size = UDim2.new(1, -(ROW_PADDING * 2 + 1), 0, 12),
		BackgroundColor3 = Theme.track,
	}, row)
	round(track, 6)

	local fill = create("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.accent,
	}, track)
	round(fill, 6)
	create("UIGradient", {
		Color = ColorSequence.new(Theme.accent, Theme.accentLight),
	}, fill)

	local hit = create("TextButton", {
		Name = "Hit",
		Position = UDim2.fromOffset(ROW_PADDING, 38),
		Size = UDim2.new(1, -(ROW_PADDING * 2 + 1), 0, 44),
	}, row)

	local control = {}

	local function render()
		local lowAlpha = (low - minimum) / (maximum - minimum)
		local highAlpha = (high - minimum) / (maximum - minimum)
		fill.Position = UDim2.fromScale(lowAlpha, 0)
		fill.Size = UDim2.fromScale(highAlpha - lowAlpha, 1)
		valueLabel.Text = formatNumber(low, decimals) .. suffix .. " - " .. formatNumber(high, decimals) .. suffix
	end

	local function apply(newLow, newHigh, silent)
		newLow = snap(newLow, minimum, maximum, increment, decimals)
		newHigh = snap(newHigh, minimum, maximum, increment, decimals)
		if newLow > newHigh then
			newLow, newHigh = newHigh, newLow
		end
		if newLow == low and newHigh == high then
			return
		end
		low, high = newLow, newHigh
		Evenesce.Flags[flag] = { low, high }
		render()
		if not silent then
			fire(callback, low, high)
		end
	end

	Evenesce.Flags[flag] = { low, high }
	render()

	hit.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end

		local function alphaAt(position)
			local point = pointerPosition(position)
			return math.clamp((point.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		end

		-- Pick the handle closest to the press and keep dragging that one.
		local startAlpha = alphaAt(input.Position)
		local lowAlpha = (low - minimum) / (maximum - minimum)
		local highAlpha = (high - minimum) / (maximum - minimum)
		local dragLow = math.abs(startAlpha - lowAlpha) <= math.abs(startAlpha - highAlpha)
		if lowAlpha == highAlpha then
			dragLow = startAlpha < lowAlpha
		end

		local function move(position)
			local target = minimum + (maximum - minimum) * alphaAt(position)
			if dragLow then
				apply(math.min(target, high), high, false)
			else
				apply(low, math.max(target, low), false)
			end
		end

		move(input.Position)
		trackDrag(input, move)
	end)

	function control.set(_, newLow, newHigh)
		apply(newLow, newHigh, false)
	end

	function control.get()
		return low, high
	end

	return control
end

---Add a dropdown row. Set Multi to allow several selections.
---@param options table
---@return table
function Section:addDropdown(options)
	local window = self.window
	local row = self:createRow(116, options.Name)
	local flag = options.Flag or options.Name
	local callback = options.Callback
	local entries = options.Options or {}
	local multi = options.Multi == true
	local value

	if multi then
		value = {}
		for _, entry in ipairs(options.Default or {}) do
			value[entry] = true
		end
	else
		value = options.Default or entries[1]
	end

	self:createLabel(row, options.Name, 22)

	local field = create("TextButton", {
		Name = "Field",
		Position = UDim2.fromOffset(ROW_PADDING, 48),
		Size = UDim2.new(1, -(ROW_PADDING * 2 + 1), 0, 53),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.elementBackground,
	}, row)
	round(field, 12)
	bindHoverFill(field, Theme.elementBackground, Color3.fromHex("#212126"))

	local valueText = create("TextLabel", {
		Name = "Value",
		Position = UDim2.fromOffset(22, 0),
		Size = UDim2.new(1, -72, 1, 0),
		Font = FONT_MEDIUM,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, field)

	local chevron = createIcon(field, "chevron-down", 22, Theme.textPrimary, "ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -34, 0.5, 0),
	})

	local control = {}

	local function describe()
		if not multi then
			return tostring(value or "")
		end

		local selected = {}
		for _, entry in ipairs(entries) do
			if value[entry] then
				table.insert(selected, entry)
			end
		end
		return #selected > 0 and table.concat(selected, ", ") or "None"
	end

	local function export()
		if not multi then
			return value
		end

		local selected = {}
		for _, entry in ipairs(entries) do
			if value[entry] then
				table.insert(selected, entry)
			end
		end
		return selected
	end

	local function render()
		valueText.Text = describe()
		Evenesce.Flags[flag] = export()
	end

	local function pick(entry)
		if multi then
			value[entry] = not value[entry] or nil
		else
			value = entry
		end
		render()
		fire(callback, export())
	end

	local function isSelected(entry)
		if multi then
			return value[entry] == true
		end
		return value == entry
	end

	render()

	field.Activated:Connect(function()
		if window.activePopup == window.listPopup and window.listAnchor == field then
			window:closePopups()
			return
		end
		window:showList(field, entries, isSelected, pick, multi)
		tween(chevron, 0.15, { Rotation = 180 })
		window.listClosed = function()
			tween(chevron, 0.15, { Rotation = 0 })
		end
	end)

	function control.set(_, newValue)
		if multi then
			value = {}
			for _, entry in ipairs(newValue or {}) do
				value[entry] = true
			end
		else
			value = newValue
		end
		render()
		fire(callback, export())
	end

	function control.get()
		return export()
	end

	function control.refresh(_, newOptions)
		entries = newOptions
		if not multi and not table.find(entries, value) then
			value = entries[1]
		end
		render()
	end

	return control
end

