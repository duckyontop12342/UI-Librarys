	local holdMode = modeButton("Hold", 0.5)

	create("Frame", {
		Name = "Divider",
		Position = UDim2.fromOffset(18, 158),
		Size = UDim2.fromOffset(325, 1),
		BackgroundColor3 = Theme.divider,
		ZIndex = 101,
	}, popup)

	local function checkRow(text, centerY)
		local label = create("TextLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromOffset(18, centerY),
			Size = UDim2.fromOffset(220, 30),
			Text = text,
			TextSize = 19,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 102,
		}, popup)

		local box = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -18, 0, centerY),
			Size = UDim2.fromOffset(31, 31),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.checkboxOff,
			ZIndex = 102,
		}, popup)
		round(box, 8)

		local check = createIcon(box, "check", 21, Theme.textPrimary, "ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			ZIndex = 103,
		})

		return function(on)
			box.BackgroundColor3 = on and Theme.accent or Theme.checkboxOff
			check.ImageTransparency = on and 0 or 1
			label.TextColor3 = on and Theme.textPrimary or Theme.textMuted
		end, box
	end

	local renderValue, valueBox = checkRow("Value", 191)
	local renderBinds, bindsBox = checkRow("Show in binds", 249)

	local ui = { popup = popup, bind = nil, control = nil }
	self.bindUi = ui

	function ui.render()
		local bind = ui.bind
		if not bind then
			return
		end

		keyLabel.Text = self.listening and "..." or (bind.Key and bind.Key.Name or "None")
		keyLabel.TextColor3 = self.listening and Theme.textMuted or Theme.textPrimary

		local holding = bind.Mode == "Hold"
		toggleMode.BackgroundTransparency = holding and 1 or 0
		holdMode.BackgroundTransparency = holding and 0 or 1

		renderValue(ui.control.get())
		renderBinds(bind.ShowInBinds)
	end

	keyBox.Activated:Connect(function()
		self.listening = true
		ui.render()
	end)

	toggleMode.Activated:Connect(function()
		ui.bind.Mode = "Toggle"
		ui.render()
	end)

	holdMode.Activated:Connect(function()
		ui.bind.Mode = "Hold"
		ui.render()
	end)

	valueBox.Activated:Connect(function()
		ui.control:set(not ui.control.get())
		ui.render()
	end)

	bindsBox.Activated:Connect(function()
		ui.bind.ShowInBinds = not ui.bind.ShowInBinds
		ui.render()
		self:refreshBinds()
	end)

	-- Capture the next key while the key box is listening.
	self:connect(userInputService.InputBegan, function(input)
		if not self.listening or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		local bind = ui.bind
		if bind then
			bind.Key = input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode or nil
		end

		self.listening = false
		self.bindCooldown = true
		task.defer(function()
			self.bindCooldown = false
		end)
		ui.render()
		self:refreshBinds()
	end)
end

