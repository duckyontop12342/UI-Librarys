---Create a section card inside a page column.
---@param page table
---@param options table
---@return table
function Section.new(page, options)
	local self = setmetatable({}, Section)
	self.page = page
	self.window = page.window
	self.name = options.Name or "Section"
	self.items = {}
	self.rowOrder = 0
	self.lastRow = nil

	local column = options.Side == "Right" and page.rightColumn or page.leftColumn

	self.holder = create("Frame", {
		Name = self.name .. "Section",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = #page.sections + 1,
	}, column)

	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 0),
	}, self.holder)

	local header = create("TextLabel", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 42),
		Text = self.name,
		Font = FONT_MEDIUM,
		TextSize = 23,
		TextColor3 = Theme.textMuted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 1,
	}, self.holder)
	create("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingTop = UDim.new(0, 2) }, header)

	self.card = create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.cardBackground,
		LayoutOrder = 2,
	}, self.holder)
	round(self.card, 18)

	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 0),
	}, self.card)

	return self
end

---Create a divided row inside the card.
---@param height number
---@param name string?
---@param noDivider boolean?
---@return Frame
function Section:createRow(height, name, noDivider)
	self.rowOrder = self.rowOrder + 1

	local row = create("Frame", {
		Name = (name or "Row") .. "Row",
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		LayoutOrder = self.rowOrder,
	}, self.card)

	local divider = create("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, ROW_PADDING, 1, 0),
		Size = UDim2.new(1, -(ROW_PADDING * 2 + 1), 0, 1),
		BackgroundColor3 = Theme.divider,
		Visible = false,
	}, row)

	if self.lastRow and not self.lastRow.noDivider then
		self.lastRow.divider.Visible = true
	end

	self.lastRow = { row = row, divider = divider, noDivider = noDivider == true }
	table.insert(self.items, { row = row, name = name or "" })

	return row
end

